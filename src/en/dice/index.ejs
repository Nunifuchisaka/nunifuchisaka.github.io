<!doctype html>
<html lang="en">
<head><%
const path = "../../";
const meta = {
  title: "Topic Dice",
  description: "A dice that randomly picks a topic when you're stuck for something to talk about during VRChat chit-chat",
  url: "en/dice/",
  altUrl: "dice/",
  titleSeparator: " | ",
};
%>
<%- include(path + "assets/html/_head",{meta:meta,locale:"en"}) %>
<link rel="stylesheet" href="/dice/dice.css">
</head>
<body>
<%- include(path + "assets/html/_body_before",{locale:"en"}) %>

<div id="wrapper">
<%- include(path + "assets/html/_header",{locale:"en"}) %>

<main id="main">
<header class="header_3">
  <h2 class="header_3__h1">
    Topic Dice
  </h2>
</header><!-- /.header_3 -->

<div class="dice_1">
  <p class="dice_1__lead">
    Stuck for a topic? Give the button a tap.
  </p>
  <button type="button" class="dice_1__button" id="js-dice-button">
    <i class="fa-solid fa-dice dice_1__icon" id="js-dice-icon" aria-hidden="true"></i>
    <span>Roll the Dice</span>
  </button>
  <div class="dice_1__result" id="js-dice-result" aria-live="polite">
    <p class="dice_1__question" id="js-dice-question">
      Press the button to reveal a topic
    </p>
    <p class="dice_1__example" id="js-dice-example"></p>
  </div>
</div><!-- /.dice_1 -->
</main><!-- /#main -->

<%- include(path + "assets/html/_footer",{locale:"en"}) %>
</div><!-- /#wrapper -->

<%- include(path + "assets/html/_body_after",{locale:"en"}) %>
<script src="/dice/dice.js" defer></script>
</body>
</html>
