  route: [
    { head: "シェーダーやツールを入れる", note: "lilToon など。アバターより先に" },
    { head: "アバターを入れる", note: ".unitypackage を読み込む" },
    { head: "シーンに置く", note: "Prefab を Hierarchy へ" },
    { head: "SDK でログイン", note: "VRChat のアカウント" },
