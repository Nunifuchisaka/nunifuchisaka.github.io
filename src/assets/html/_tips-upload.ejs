%><article class="article_1" aria-labelledby="article-heading">
  <header class="section_2 page_1 article_1__header">
    <p class="article_1__series"><a href="<%= prefix %>/avatar-tips/"><%= l.series %></a></p>
    <h1 class="page_1__h1" id="article-heading"><%= l.title %></h1>
    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="flow" aria-labelledby="flow-heading">
    <h2 class="section_2__h1" id="flow-heading"><%= l.flowTitle %></h2>
    <p class="article_1__p"><%- l.flowLead %></p>
    <ol class="route_1">
      <% l.route.forEach(function (step) { %>
        <li class="route_1__step"><span class="route_1__head"><%= step.head %></span><span class="route_1__note"><%= step.note %></span></li>
      <% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="need" aria-labelledby="need-heading">
    <h2 class="section_2__h1" id="need-heading"><%= l.needTitle %></h2>
    <dl class="examples_1 examples_1--grid">
      <% l.need.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%- item.body %></dd>
        </div>
      <% }); %>
    </dl>
  </section>

  <section class="section_2 article_1__section" id="import" aria-labelledby="import-heading">
    <h2 class="section_2__h1" id="import-heading"><%= l.importTitle %></h2>
    <p class="article_1__p"><%= l.importLead %></p>
    <ol class="steps_1">
      <% l.importSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <p class="article_1__p"><%= l.importNote %></p>
  </section>

  <section class="section_2 article_1__section" id="place" aria-labelledby="place-heading">
    <h2 class="section_2__h1" id="place-heading"><%= l.placeTitle %></h2>
    <ol class="steps_1">
      <% l.placeSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="login" aria-labelledby="login-heading">
    <h2 class="section_2__h1" id="login-heading"><%= l.loginTitle %></h2>
    <ol class="steps_1">
      <% l.loginSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="builder" aria-labelledby="builder-heading">
    <h2 class="section_2__h1" id="builder-heading"><%= l.builderTitle %></h2>
    <p class="article_1__p"><%= l.builderLead %></p>
    <%- include("_mock", { mock: l.builderMock }) %>
    <ol class="steps_1">
      <% l.builderSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <p class="article_1__p"><%- l.testNote %></p>
  </section>

  <section class="section_2 article_1__section" id="validations" aria-labelledby="validations-heading">
    <h2 class="section_2__h1" id="validations-heading"><%= l.validTitle %></h2>
    <% l.valid.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <section class="table_3" tabindex="0" aria-label="<%= l.validTableLabel %>">
      <table>
        <thead>
          <tr><% l.validHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.validRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%= row[1] %></td><td><%= row[2] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <%- include("_mock", { mock: l.validMock }) %>
  </section>

  <section class="section_2 article_1__section" id="update" aria-labelledby="update-heading">
    <h2 class="section_2__h1" id="update-heading"><%= l.updateTitle %></h2>
    <% l.update.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <%- include("_mock", { mock: l.pipelineMock }) %>
    <p class="article_1__p"><%= l.updateCare %></p>
  </section>

  <section class="section_2 article_1__section" id="check" aria-labelledby="check-heading">
    <h2 class="section_2__h1" id="check-heading"><%= l.checkTitle %></h2>
    <ol class="steps_1">
      <% l.checkSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <p class="article_1__p"><%= l.checkNote %></p>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%- c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%- c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
    <p class="article_1__p"><%- l.sourceNote %></p>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
