const sections = [
  { id: "when", title: l.whenTitle },
  { id: "flow", title: l.flowTitle },
  { id: "need", title: l.needTitle },
  { id: "import", title: l.importTitle },
  { id: "place", title: l.placeTitle },
  { id: "login", title: l.loginTitle },
  { id: "builder", title: l.builderTitle },
  { id: "validations", title: l.validTitle },
  { id: "update", title: l.updateTitle },
  { id: "check", title: l.checkTitle },
  { id: "cases", title: l.casesTitle },
  { id: "care", title: l.careTitle },
  { id: "summary", title: l.sumTitle },
