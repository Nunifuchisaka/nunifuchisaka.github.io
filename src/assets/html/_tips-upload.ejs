<%
const pageLocale = typeof locale !== "undefined" ? locale : "ja";
const isEn = pageLocale === "en";
const prefix = isEn ? "/en" : "";
// アバター改変の解説：アップロードのしかた
// 本文の文字列は code や strong の HTML を含むので、エスケープせずに出す。再現図（_mock）は本物の画面写真ではない
// 英語版は、日本語版の内容が固まってから作る（それまで英語の文は置かない）
const article = avatarTips.articles.find((a) => a.slug === "upload");
const tip = (slug) => avatarTips.articles.find((a) => a.slug === slug);
const tipNo = (slug) => `第${tip(slug).no}回`;
const [py, pm, pd] = article.published.split("-").map(Number);
const published = `${py}年${pm}月${pd}日`;
const links = {
  setup: `${prefix}/avatar-tips/setup/`,
  unityVsVrchat: `${prefix}/avatar-tips/unity-vs-vrchat/`,
  performance: `${prefix}/avatar-tips/performance/`,
  firstAvatar: "https://creators.vrchat.com/avatars/creating-your-first-avatar/",
};
const newTab = "（新しいタブで開きます）";
const ext = (href, text) => `<a href="${href}" target="_blank" rel="noopener">${text}<span class="visually-hidden">${newTab}</span></a>`;

const l = {
  series: `アバター改変の解説 第${article.no}回`,
