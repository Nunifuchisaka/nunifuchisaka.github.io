    variant: "unity",
    caption: "再現図：Builder の Validations。メッセージは例で、実際の画面では英語で出ます",
    screens: [{
      bar: "VRChat SDK › Builder › Validations",
      label: "Validations の再現図。1 赤いエラーと Auto Fix のボタン、2 黄色い警告と Select のボタン、3 パフォーマンスランクのお知らせ",
      rows: [
        { type: "head", text: "Validations" },
        { mark: 1, label: "✕ エラー：直さないとアップロードできない", type: "button", text: "Auto Fix", hot: true },
        { mark: 2, label: "! 警告：ポリゴンが多い", type: "button", text: "Select" },
