const sections = [
  { id: "when", title: l.whenTitle },
  { id: "picture", title: l.pictureTitle },
  { id: "words", title: l.wordsTitle },
  { id: "layers", title: l.layersTitle },
  { id: "controller", title: l.controllerTitle },
  { id: "parameters", title: l.paramsTitle },
  { id: "menu", title: l.menuTitle },
  { id: "demo", title: l.demoTitle },
  { id: "cases", title: l.casesTitle },
  { id: "care", title: l.careTitle },
  { id: "summary", title: l.sumTitle },
];
%><article class="article_1" aria-labelledby="article-heading">
  <header class="section_2 page_1 article_1__header">
    <p class="article_1__series"><a href="<%= prefix %>/avatar-tips/"><%= l.series %></a></p>
    <h1 class="page_1__h1" id="article-heading"><%= l.title %></h1>
    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="picture" aria-labelledby="picture-heading">
    <h2 class="section_2__h1" id="picture-heading"><%= l.pictureTitle %></h2>
    <% l.picture.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <ol class="route_1">
      <% l.route.forEach(function (step) { %>
        <li class="route_1__step"><span class="route_1__head"><%= step.head %></span><span class="route_1__note"><%= step.note %></span></li>
      <% }); %>
    </ol>
    <% l.picture2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="words" aria-labelledby="words-heading">
    <h2 class="section_2__h1" id="words-heading"><%= l.wordsTitle %></h2>
    <p class="article_1__p"><%= l.wordsLead %></p>
    <dl class="examples_1 examples_1--grid">
      <% l.words.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%- item.body %></dd>
        </div>
      <% }); %>
    </dl>
  </section>

  <section class="section_2 article_1__section" id="layers" aria-labelledby="layers-heading">
    <h2 class="section_2__h1" id="layers-heading"><%= l.layersTitle %></h2>
    <% l.layers.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <dl class="examples_1 examples_1--grid">
      <% l.layerItems.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%- item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <% l.layers2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <%- include("_mock", { mock: l.descriptorMock }) %>
  </section>

  <section class="section_2 article_1__section" id="controller" aria-labelledby="controller-heading">
    <h2 class="section_2__h1" id="controller-heading"><%= l.controllerTitle %></h2>
    <% l.controller.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <dl class="examples_1">
      <% l.parts.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%- item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <%- include("_mock", { mock: l.animatorMock }) %>
    <section class="table_3" tabindex="0" aria-label="<%= l.transTableLabel %>">
      <table>
        <thead>
          <tr><% l.transHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.transRows.forEach(function (row) { %>
            <tr><th scope="row" class="table_3__nowrap"><%= row[0] %></th><td><%= row[1] %></td><td><%= row[2] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.controller2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="parameters" aria-labelledby="parameters-heading">
    <h2 class="section_2__h1" id="parameters-heading"><%= l.paramsTitle %></h2>
    <% l.params.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <section class="table_3" tabindex="0" aria-label="<%= l.typesTableLabel %>">
      <table>
        <thead>
          <tr><% l.typesHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.typesRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%= row[1] %></td><td class="table_3__nowrap"><%= row[2] %></td><td><%- row[3] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.params2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <dl class="examples_1">
      <% l.paramOpts.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%- item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <% l.params3.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <%- include("_mock", { mock: l.paramsMock }) %>
  </section>

  <section class="section_2 article_1__section" id="menu" aria-labelledby="menu-heading">
    <h2 class="section_2__h1" id="menu-heading"><%= l.menuTitle %></h2>
    <% l.menu.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <section class="table_3" tabindex="0" aria-label="<%= l.menuTableLabel %>">
      <table>
        <thead>
          <tr><% l.menuHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.menuRows.forEach(function (row) { %>
            <tr><th scope="row" class="table_3__nowrap"><%= row[0] %></th><td><%= row[1] %></td><td><%= row[2] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.menu2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <%- include("_mock", { mock: l.menuMock }) %>
    <% l.menu3.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="demo" aria-labelledby="demo-heading">
    <h2 class="section_2__h1" id="demo-heading"><%= l.demoTitle %></h2>
    <p class="article_1__p"><%= l.demoLead %></p>
    <div class="demo_2 js_ab_demo"
      data-param-same="<%= l.demo.paramSame %>" data-param-diff="<%= l.demo.paramDiff %>"
      data-state-on="<%= l.demo.stateOn %>" data-state-off="<%= l.demo.stateOff %>"
      data-write1="<%= l.demo.write1 %>" data-write0="<%= l.demo.write0 %>"
      data-shown="<%= l.demo.shown %>" data-hidden="<%= l.demo.hidden %>"
      data-ok="<%= l.demo.ok %>" data-ng="<%= l.demo.ng %>">
      <div class="demo_2__faces">
        <div class="demo_2__face">
          <p class="demo_2__who"><%= l.demo.animator %></p>
          <%- graph %>
          <p class="demo_2__num"><%= l.demo.stateLabel %> <span class="js_ab_state_name">Hat_OFF</span></p>
        </div>
        <div class="demo_2__face">
          <p class="demo_2__who"><%= l.demo.look %></p>
          <%- hatFace(false) %>
          <p class="demo_2__num">Is Active <span class="js_ab_active">0</span></p>
        </div>
      </div>
      <div class="demo_2__controls">
        <fieldset class="demo_1__distance">
          <legend class="demo_1__label"><%= l.demo.menuLegend %></legend>
          <label><input type="checkbox" class="js_ab_menu"> <%= l.demo.menuText %></label>
        </fieldset>
        <fieldset class="demo_1__distance">
          <legend class="demo_1__label"><%= l.demo.weight %></legend>
          <label><input type="radio" name="ab-weight" value="1" class="js_ab_weight" checked> 1</label>
          <label><input type="radio" name="ab-weight" value="0" class="js_ab_weight"> 0</label>
        </fieldset>
        <fieldset class="demo_1__distance">
          <legend class="demo_1__label"><%= l.demo.name %></legend>
          <% l.demo.names.forEach(function (n, i) { %>
            <label><input type="radio" name="ab-name" value="<%= n.value %>" class="js_ab_name"<% if (i === 0) { %> checked<% } %>> <%= n.text %></label>
          <% }); %>
        </fieldset>
      </div>
      <div class="demo_2__output" aria-live="polite">
        <p class="demo_1__why js_ab_why" data-step="param"><%= l.demo.paramSame.replace(/\{v\}/g, "false") %></p>
        <p class="demo_1__why js_ab_why" data-step="state"><%= l.demo.stateOff.replace("{n}", "Hat") %></p>
        <p class="demo_1__why js_ab_why" data-step="write"><%= l.demo.write1.replace("{s}", "Hat_OFF").replace("{a}", "0") %></p>
        <p class="demo_1__result is_ok js_ab_result"><%= l.demo.ok.replace("{x}", l.demo.hidden) %></p>
      </div>
      <noscript><p class="section_2__note"><%= l.demo.noJs %></p></noscript>
    </div>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%= c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.cause %></dt><dd><%= c.cause %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%- c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%- item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%- item %></li><% }); %>
    </ul>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
