%><article class="article_1" aria-labelledby="article-heading">
  <header class="section_2 page_1 article_1__header">
    <p class="article_1__series"><a href="<%= prefix %>/avatar-tips/"><%= l.series %></a></p>
    <h1 class="page_1__h1" id="article-heading"><%= l.title %></h1>
    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
    <p class="article_1__p"><%- l.before %></p>
  </section>

  <section class="section_2 article_1__section" id="plan" aria-labelledby="plan-heading">
    <h2 class="section_2__h1" id="plan-heading"><%= l.planTitle %></h2>
    <% l.plan.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <ol class="route_1">
      <% l.route.forEach(function (step) { %>
        <li class="route_1__step"><span class="route_1__head"><%= step.head %></span><span class="route_1__note"><%= step.note %></span></li>
      <% }); %>
    </ol>
    <% l.plan2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="controller" aria-labelledby="controller-heading">
    <h2 class="section_2__h1" id="controller-heading"><%= l.controllerTitle %></h2>
    <p class="article_1__p"><%- l.controllerLead %></p>
    <ol class="steps_1">
      <% l.controller.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.controllerMock }) %>
  </section>

  <section class="section_2 article_1__section" id="clips" aria-labelledby="clips-heading">
    <h2 class="section_2__h1" id="clips-heading"><%= l.clipsTitle %></h2>
    <p class="article_1__p"><%- l.clipsLead %></p>
    <ol class="steps_1">
      <% l.clips.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <% l.clipsWhy.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <p class="section_2__more"><%- l.clipsLink %></p>
  </section>

  <section class="section_2 article_1__section" id="transitions" aria-labelledby="transitions-heading">
    <h2 class="section_2__h1" id="transitions-heading"><%= l.transitionsTitle %></h2>
    <p class="article_1__p"><%= l.transitionsLead %></p>
    <ol class="steps_1">
      <% l.transitions.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.transitionMock }) %>
    <h3 class="section_2__h2"><%= l.whyTitle %></h3>
    <% l.why.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="connect" aria-labelledby="connect-heading">
    <h2 class="section_2__h1" id="connect-heading"><%= l.connectTitle %></h2>
    <p class="article_1__p"><%= l.connectLead %></p>
    <dl class="examples_1 examples_1--grid">
      <% l.connectWays.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%- item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <h3 class="section_2__h2"><%= l.connectMaTitle %></h3>
    <ol class="steps_1">
      <% l.connectMa.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.connectMock }) %>
    <p class="section_2__note"><%= l.connectMaNote %></p>
    <h3 class="section_2__h2"><%= l.connectDirectTitle %></h3>
    <ol class="steps_1">
      <% l.connectDirect.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <p class="article_1__p"><%= l.connectRisks %><%- l.wdLink %><%= l.connectRisksEnd %></p>
  </section>

  <section class="section_2 article_1__section" id="params" aria-labelledby="params-heading">
    <h2 class="section_2__h1" id="params-heading"><%= l.paramsTitle %></h2>
    <p class="article_1__p"><%- l.paramsLead %></p>
    <ol class="steps_1">
      <% l.params.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.paramsMock }) %>
    <section class="table_3" tabindex="0" aria-label="<%= l.paramsTableLabel %>">
      <table>
        <thead>
          <tr><% l.paramsHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.paramsRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%= row[1] %></td><td><%= row[2] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <p class="article_1__p"><%- l.sceneNote %></p>
    <% l.paramsDirect.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="menu" aria-labelledby="menu-heading">
    <h2 class="section_2__h1" id="menu-heading"><%= l.menuTitle %></h2>
    <p class="article_1__p"><%- l.menuLead %></p>
    <ol class="steps_1">
      <% l.menu.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.menuMock }) %>
    <ul class="rules_1">
      <% l.menuNotes.forEach(function (item) { %><li><%- item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="demo" aria-labelledby="demo-heading">
    <h2 class="section_2__h1" id="demo-heading"><%= l.demoTitle %></h2>
    <p class="article_1__p"><%= l.demoLead %></p>
    <div class="demo_2 js_toggle_demo"
      data-idle="<%= d.idle %>" data-name-ng="<%= d.nameNg %>" data-weight-ng="<%= d.weightNg %>"
      data-synced-ng="<%= d.syncedNg %>" data-exit-ng="<%= d.exitNg %>" data-ok="<%= d.ok %>"
      data-result="<%= d.result %>" data-shown="<%= d.shown %>" data-hidden="<%= d.hidden %>"<% if (d.sep) { %> data-sep="<%= d.sep %>"<% } %>>
      <div class="demo_2__faces">
        <div class="demo_2__face">
          <p class="demo_2__who"><%= d.self %></p>
          <div class="js_toggle_face" data-face="self"><%- head(false) %></div>
        </div>
        <div class="demo_2__face">
          <p class="demo_2__who"><%= d.other %></p>
          <div class="js_toggle_face" data-face="other"><%- head(false) %></div>
        </div>
      </div>
      <div class="demo_2__controls">
        <fieldset class="demo_1__distance">
          <legend class="demo_1__label"><%= d.menu %></legend>
          <label><input type="checkbox" class="js_toggle_menu"> <%= d.menuItem %></label>
        </fieldset>
        <fieldset class="demo_1__distance">
          <legend class="demo_1__label"><%= d.make %></legend>
          <label><input type="checkbox" class="js_toggle_check" data-check="weight" checked> <%= d.weight %></label>
          <label><input type="checkbox" class="js_toggle_check" data-check="name" checked> <%= d.name %></label>
          <label><input type="checkbox" class="js_toggle_check" data-check="exit" checked> <%= d.exit %></label>
          <label><input type="checkbox" class="js_toggle_check" data-check="synced" checked> <%= d.synced %></label>
        </fieldset>
      </div>
      <div class="demo_2__output" aria-live="polite">
        <p class="demo_1__why js_toggle_why"><%= d.idle %></p>
        <p class="demo_1__result js_toggle_result"><%= d.result.replace("{s}", d.hidden).replace("{o}", d.hidden) %></p>
      </div>
      <noscript><p class="section_2__note"><%= d.noJs %></p></noscript>
    </div>
  </section>

  <section class="section_2 article_1__section" id="test" aria-labelledby="test-heading">
    <h2 class="section_2__h1" id="test-heading"><%= l.testTitle %></h2>
    <p class="article_1__p"><%= l.testLead %></p>
    <ol class="steps_1">
      <% l.test.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <h3 class="section_2__h2"><%= l.uploadTitle %></h3>
    <ol class="steps_1">
      <% l.upload.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%= c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.cause %></dt><dd><%= c.cause %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%= c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
    <p class="article_1__p"><%- l.next %></p>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
