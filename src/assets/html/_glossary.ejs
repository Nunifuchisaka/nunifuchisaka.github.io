<%
// VRChat 用語集。中身は src/assets/data/glossary.json（改変解説の本文の用語リンク・ツールチップと共通）
// 種類ごとに h2、用語ごとに h3（id は用語の id。本文のリンクは /glossary/#<id> に飛ぶ）。
// ことばで絞り込む部品（glossary-filter.js）は、JS が無いときは出さず、全部を並べる
// 英語版は、管理人が日本語版の内容を固めてから作る（それまで英語の文は置かない）
const terms = glossary.categories.flatMap((c) => c.terms);
const termById = (id) => terms.find((t) => t.id === id);
const tip = (slug) => avatarTips.articles.find((a) => a.slug === slug);
const total = terms.length;
const SITE = "https://nunifuchisaka.github.io/";
const strip = (t) => t.replace(/<[^>]+>/g, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": `${SITE}glossary/#set`,
  name: "VRChat 用語集",
  description: "VRChat のアバター改変で出てくる専門用語を、はじめての人向けに短く説明した用語集。",
  url: `${SITE}glossary/`,
  inLanguage: "ja",
  hasDefinedTerm: terms.map((t) => ({
    "@type": "DefinedTerm",
    "@id": `${SITE}glossary/#${t.id}`,
    name: t.term,
    description: `${t.short}${strip(t.body)}`,
    url: `${SITE}glossary/#${t.id}`,
    inDefinedTermSet: `${SITE}glossary/#set`,
  })),
};
%><section class="section_2 page_1" aria-labelledby="glossary-heading">
  <h1 class="page_1__h1" id="glossary-heading">VRChat 用語集</h1>
  <p class="section_2__lead">VRChat のアバター改変で出てくる言葉<%= total %>語を、はじめての人向けに1〜2文で説明します。Unity の画面、VRChat SDK、Animator とギミック、Modular Avatar、アップロードとパフォーマンスランクの言葉を集めました。</p>
  <p class="section_2__note">「<a href="/avatar-tips/">アバター改変の解説</a>」の本文では、ここにある言葉に点線が付いています。マウスを乗せると短い説明が出て、押すとこのページの説明へ飛びます。</p>
  <nav class="jump_1" aria-label="このページの中">
    <ul>
      <% glossary.categories.forEach(function (c) { %>
        <li><a href="#cat-<%= c.id %>"><%= c.title %></a></li>
      <% }); %>
    </ul>
  </nav>
</section>

<div class="section_2 glossary_1 js_glossary" data-count="{n} 語">
  <div class="glossary_1__controls js_glossary_controls" hidden>
    <label class="filter_1__legend" for="glossary-search">ことばで絞り込む</label>
    <input type="search" id="glossary-search" class="finder_1__input js_glossary_search" placeholder="例：Write Defaults、同期、ピンク" autocomplete="off">
    <p class="finder_1__count" aria-live="polite"><span class="js_glossary_count"><%= total %> 語</span></p>
  </div>
  <p class="finder_1__none js_glossary_none" hidden>当てはまる言葉がありません。ことばを短くするか、上の種類から探してください。</p>

  <% glossary.categories.forEach(function (c) { %>
    <section class="glossary_1__cat js_glossary_cat" id="cat-<%= c.id %>" aria-labelledby="cat-<%= c.id %>-heading">
      <h2 class="section_2__h1" id="cat-<%= c.id %>-heading"><%= c.title %></h2>
      <p class="section_2__lead"><%= c.lead %></p>
      <div class="glossary_1__list">
        <% c.terms.forEach(function (t) { %>
          <section class="glossary_1__item js_glossary_item" id="<%= t.id %>" aria-labelledby="<%= t.id %>-heading" data-text="<%= [t.term].concat(t.match, [t.short, strip(t.body)]).join(" ") %>">
            <h3 class="glossary_1__term" id="<%= t.id %>-heading"><%= t.term %></h3>
            <p class="glossary_1__short"><%= t.short %></p>
            <p class="glossary_1__body"><%- t.body %></p>
            <% if (t.tips.length) { %>
              <p class="glossary_1__links"><span class="glossary_1__label">くわしく</span>
                <% t.tips.forEach(function (x, i) { const a = tip(x[0]); %><a href="/avatar-tips/<%= a.slug %>/#<%= x[1] %>">第<%= a.no %>回 <%= a.title.ja %></a><% if (i < t.tips.length - 1) { %>、<% } %><% }); %>
              </p>
            <% } %>
            <% if (t.see.length) { %>
              <p class="glossary_1__links"><span class="glossary_1__label">関係する言葉</span>
                <% t.see.forEach(function (id, i) { const s = termById(id); %><a href="#<%= s.id %>"><%= s.term %></a><% if (i < t.see.length - 1) { %>、<% } %><% }); %>
              </p>
            <% } %>
          </section>
        <% }); %>
      </div>
    </section>
  <% }); %>
</div>

<section class="section_2" aria-labelledby="glossary-more-heading">
  <h2 class="section_2__h1" id="glossary-more-heading">もっとくわしく知りたいとき</h2>
  <p class="section_2__lead">言葉の使い方や、つまずいたときの直し方は「<a href="/avatar-tips/">アバター改変の解説</a>」で、1回に1つずつ解説しています。困りごとから、読む回を探すこともできます。</p>
</section>
<script type="application/ld+json">
<%- JSON.stringify(jsonLd, null, 2).replace(/</g, "\\u003c") %>
</script>
