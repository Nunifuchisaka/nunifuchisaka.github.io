<%
const pageLocale = typeof locale !== "undefined" ? locale : "ja";
const MONTHS_EN = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const formatDate = (file) => {
  const m = file.match(/(\d{4})-(\d{2})-(\d{2})/);
  if (!m) return "";
  const y = +m[1], mo = +m[2], d = +m[3];
  return pageLocale === "en" ? `${MONTHS_EN[mo - 1]} ${d}, ${y}` : `${y}年${mo}月${d}日`;
};
const count = guideAtlas.files.length;
const firstDate = count ? formatDate(guideAtlas.files[0]) : "";
const t = {
  ja: {
    name: "ぬにふちさか",
    navLabel: "サイト内",
    timeline: "案内実績",
    equipment: "VR機材",
    videos: "回想",
    dice: "話題サイコロ",
    langLabel: "言語切替",
    toDark: "ダークにする",
    toLight: "ライトにする",
    caption: `VRChatを始めた人を案内した日の写真、${count}枚。`,
    structure: `真ん中が最初の日（${firstDate}）で、外側ほど新しい日です。`,
    more: "日付ごとの一覧を見る",
    hint: "写真に触れると日付が出ます。クリックすると大きく開きます。",
  },
  en: {
    name: "Nunifuchisaka",
    navLabel: "Site",
    timeline: "Guide Log",
    equipment: "VR Gear",
    videos: "Memories",
    dice: "Topic Dice",
    langLabel: "Language",
    toDark: "Switch to dark",
    toLight: "Switch to light",
    caption: `${count} photos from days I helped someone get started in VRChat.`,
    structure: `The center is the first day (${firstDate}); newer days grow outward.`,
    more: "Browse them by date",
    hint: "Point at a photo to see its date. Click to open it.",
  },
};
const l = t[pageLocale];
const prefix = pageLocale === "en" ? "/en" : "";
const flakeData = {
  atlas: guideAtlas.file,
  tile: guideAtlas.tile,
  cols: guideAtlas.cols,
  photos: guideAtlas.files.map((file) => ({ file: file, date: formatDate(file) })),
};
%><header class="header_4">
  <div class="header_4__inner">
    <h1 class="header_4__title"><a class="header_4__home" href="<%= prefix %>/" aria-current="page"><%= l.name %></a></h1>
    <nav class="header_4__nav" aria-label="<%= l.navLabel %>">
      <ul>
        <li><a href="<%= prefix %>/timeline/"><%= l.timeline %></a></li>
        <li><a href="<%= prefix %>/equipment/"><%= l.equipment %></a></li>
        <li><a href="<%= prefix %>/videos/"><%= l.videos %></a></li>
        <li><a href="<%= prefix %>/dice/"><%= l.dice %></a></li>
      </ul>
    </nav>
    <div class="header_4__tools">
      <label class="visually-hidden" for="js-lang-select"><%= l.langLabel %></label>
      <select class="header_4__select" id="js-lang-select">
        <option value="ja"<% if (pageLocale === "ja") { %> selected<% } %>>日本語</option>
        <option value="en"<% if (pageLocale === "en") { %> selected<% } %>>English</option>
      </select>
      <button type="button" class="header_4__theme js_theme_toggle" data-label-dark="<%= l.toDark %>" data-label-light="<%= l.toLight %>"><%= l.toDark %></button>
    </div>
  </div>
</header><!-- /.header_4 -->

<div class="stage_2 js_flake_stage">
  <div class="stage_2__canvas js_flake_canvas" aria-hidden="true"></div>
  <p class="stage_2__date js_flake_date" aria-hidden="true"></p>
  <div class="stage_2__text">
    <p class="stage_2__caption"><%= l.caption %><span class="stage_2__structure"><%= pageLocale === "en" ? " " : "" %><%= l.structure %></span> <a href="#guide"><%= l.more %></a></p>
    <p class="stage_2__hint"><%= l.hint %></p>
  </div>
  <script type="application/json" class="js_flake_data"><%- JSON.stringify(flakeData) %></script>
</div><!-- /.stage_2 -->
