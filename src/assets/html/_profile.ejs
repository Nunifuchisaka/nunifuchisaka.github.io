<%
const pageLocale = typeof locale !== "undefined" ? locale : "ja";
const isEn = pageLocale === "en";
const t = {
  ja: {
    name: "ぬにふちさか",
    navLabel: "サイト内",
    timeline: "案内実績",
    equipment: "VR機材",
    videos: "回想",
    dice: "話題サイコロ",
    langLabel: "言語切替",
    toDark: "ダークにする",
    toLight: "ライトにする",
  },
  en: {
    name: "Nunifuchisaka",
    navLabel: "Site",
    timeline: "Guide Log",
    equipment: "VR Gear",
    videos: "Memories",
    dice: "Topic Dice",
    langLabel: "Language",
    toDark: "Switch to dark",
    toLight: "Switch to light",
  },
};
const l = t[pageLocale];
const prefix = isEn ? "/en" : "";
%><header class="header_4">
  <div class="header_4__inner">
    <h1 class="header_4__title"><a class="header_4__home" href="<%= prefix %>/" aria-current="page"><%= l.name %></a></h1>
    <nav class="header_4__nav" aria-label="<%= l.navLabel %>">
      <ul>
        <li><a href="<%= prefix %>/timeline/"><%= l.timeline %></a></li>
        <li><a href="<%= prefix %>/equipment/"><%= l.equipment %></a></li>
        <li><a href="<%= prefix %>/videos/"><%= l.videos %></a></li>
        <li><a href="<%= prefix %>/dice/"><%= l.dice %></a></li>
      </ul>
    </nav>
    <div class="header_4__tools">
      <label class="visually-hidden" for="js-lang-select"><%= l.langLabel %></label>
      <select class="header_4__select" id="js-lang-select">
        <option value="ja"<% if (!isEn) { %> selected<% } %>>日本語</option>
        <option value="en"<% if (isEn) { %> selected<% } %>>English</option>
      </select>
      <button type="button" class="header_4__theme js_theme_toggle" data-label-dark="<%= l.toDark %>" data-label-light="<%= l.toLight %>"><%= l.toDark %></button>
    </div>
  </div>
</header><!-- /.header_4 -->
