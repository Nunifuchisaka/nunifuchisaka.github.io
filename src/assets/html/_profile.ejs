<%
const pageLocale = typeof locale !== "undefined" ? locale : "ja";
const t = {
  ja: {
    name: "ぬにふちさか",
    nameLang: "ja",
    reading: "Nunifuchisaka",
    readingLang: "en",
    lead: "冬生まれ雪国育ち、氷属性の召喚獣。",
    hint: "横にドラッグすると氷晶が回ります",
    fallbackAlt: "ぬにふちさか",
    navLabel: "サイト内",
    timeline: "案内実績",
    equipment: "VR機材",
    videos: "回想",
    dice: "話題サイコロ",
    langLabel: "言語切替",
    toDark: "ダークにする",
    toLight: "ライトにする",
  },
  en: {
    name: "Nunifuchisaka",
    nameLang: "en",
    reading: "ぬにふちさか",
    readingLang: "ja",
    lead: "A summon beast of the ice element, born in winter and raised in snow country.",
    hint: "Drag sideways to turn the crystal",
    fallbackAlt: "Nunifuchisaka",
    navLabel: "Site",
    timeline: "Guide Log",
    equipment: "VR Gear",
    videos: "Memories",
    dice: "Topic Dice",
    langLabel: "Language",
    toDark: "Switch to dark",
    toLight: "Switch to light",
  },
};
const l = t[pageLocale];
const prefix = pageLocale === "en" ? "/en" : "";
%><header class="header_4">
  <div class="header_4__inner">
    <a class="header_4__home" href="<%= prefix %>/" aria-current="page"><%= l.name %></a>
    <nav class="header_4__nav" aria-label="<%= l.navLabel %>">
      <ul>
        <li><a href="<%= prefix %>/timeline/"><%= l.timeline %></a></li>
        <li><a href="<%= prefix %>/equipment/"><%= l.equipment %></a></li>
        <li><a href="<%= prefix %>/videos/"><%= l.videos %></a></li>
        <li><a href="<%= prefix %>/dice/"><%= l.dice %></a></li>
      </ul>
    </nav>
    <div class="header_4__tools">
      <label class="visually-hidden" for="js-lang-select"><%= l.langLabel %></label>
      <select class="header_4__select" id="js-lang-select">
        <option value="ja"<% if (pageLocale === "ja") { %> selected<% } %>>日本語</option>
        <option value="en"<% if (pageLocale === "en") { %> selected<% } %>>English</option>
      </select>
      <button type="button" class="header_4__theme js_theme_toggle" data-label-dark="<%= l.toDark %>" data-label-light="<%= l.toLight %>"><%= l.toDark %></button>
    </div>
  </div>
</header><!-- /.header_4 -->

<div class="stage_1 js_crystal_stage" data-photo="/assets/img/crystal.webp">
  <div class="stage_1__canvas js_crystal_canvas" aria-hidden="true"></div>
  <div class="stage_1__fallback" aria-hidden="true">
    <img src="/assets/img/crystal.webp" alt="" width="400" height="540" draggable="false">
  </div>
  <div class="stage_1__text">
    <h1 class="stage_1__name js_crystal_name" lang="<%= l.nameLang %>"><%= l.name %></h1>
    <p class="stage_1__reading" lang="<%= l.readingLang %>"><%= l.reading %></p>
    <p class="stage_1__lead"><%= l.lead %></p>
  </div>
  <p class="stage_1__hint"><%= l.hint %></p>
</div><!-- /.stage_1 -->
