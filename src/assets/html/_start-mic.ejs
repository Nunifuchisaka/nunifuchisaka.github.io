const troubles = [
  { title: "声がまったく届かない",
    check: "VRChat でミュートになっていないか → VRChat の「Microphone」で選んだマイク → Windows のマイクのアクセス許可（とくにデスクトップ アプリ）→ Windows の入力のバーが話すと動くか、の順に確かめます。" },
  { title: "声が小さい",
    check: "Windows の入力の音量と、VRChat の Mic Output Volume を確かめます。マイクと口が離れていないかも見ます。相手が、あなたの声だけを個別に小さくしていることもあります。" },
  { title: "声が途切れる、話し始めが切れる",
    check: "Mic Activation Threshold を下げます。それでも切れるときは、Noise Suppression をオフにします。無線でつないでいるときは、電波の具合でも途切れます。" },
  { title: "雑音や息の音が入る",
    check: "Noise Suppression をオンにして、Mic Activation Threshold を少し上げます。マイク ブーストを下げ、マイクを口の正面から少しずらします。" },
  { title: "相手の声が、自分の声に混ざって返る",
    check: "スピーカーで聞いていると、相手の声をマイクが拾って送り返します。イヤホンやヘッドホンで聞きます。自分の声が自分に聞こえるときは、Windows の「このデバイスを聴く」を外します。" },
  { title: "ゴーグルを替えたら声が届かなくなった",
    check: "VRChat の「Microphone」と Windows の入力で、新しいゴーグルのマイクを選び直します。PCVR では、SteamVR の設定の「オーディオ」でも、SteamVR を使っている間のマイクを選べます。" },
];
%><section class="section_2" id="mic" aria-labelledby="mic-heading">
  <h2 class="section_2__h1" id="mic-heading">マイクの設定</h2>
  <p class="section_2__lead">VRChat で話した声は、マイク → Windows → VRChat → 相手 の順に届きます。どこか1か所でも止まると、声は届きません。声が届かない、小さい、途切れるときは、この順に確かめてください。</p>
  <ol class="route_1">
    <% route.forEach(function (step) { %>
      <li class="route_1__step"><span class="route_1__head"><%= step.head %></span><span class="route_1__note"><%= step.note %></span></li>
    <% }); %>
  </ol>
  <p class="section_2__note">Quest だけで遊ぶときは、Windows の設定は関係ありません。Quest の設定で、VRChat にマイクの使用が許可されているかを確かめます。</p>

  <h3 class="section_2__h2">ひとりで確かめる</h3>
  <ul class="rules_1">
    <li>画面の端に、斜線の入ったマイクのアイコンが出ているときはミュート中です。</li>
    <li>鏡の前で話すと、口が動くアバターなら、声に合わせて口が動きます。口が動けば、声は VRChat まで届いています。</li>
    <li>Windows のサウンドの設定で、話すと入力のバーが動くかを見ます。動かなければ、Windows までも届いていません。</li>
  </ul>

  <h3 class="section_2__h2">VRChat の中の設定</h3>
  <p class="section_2__p">メインメニューの Settings の「Audio &amp; Voice」に、マイクの項目があります。クイックメニューの設定からも変えられます。日本語表示にしているときは、項目の名前も日本語になります。</p>
  <%- include("_mock", { mock: vrchatMock }) %>

  <h3 class="section_2__h2">Windows の設定</h3>
  <p class="section_2__p">パソコンで遊ぶとき（PCVR とデスクトップモード）は、Windows の設定も確かめます。Windows 11 の画面で説明します。Windows 10 にも、ほぼ同じ項目があります。</p>
  <%- include("_mock", { mock: windowsSoundMock }) %>
  <%- include("_mock", { mock: windowsPrivacyMock }) %>
  <p class="section_2__p">さらに細かい設定は、「設定」→「システム」→「サウンド」の下のほうにある「サウンドの詳細設定」（Windows の版によっては「その他のサウンド設定」）を開き、「録音」タブでマイクを選んで「プロパティ」を押すと出ます。</p>
  <%- include("_mock", { mock: windowsDialogMock }) %>
  <p class="section_2__p">PCVR では、SteamVR を起動すると、Windows の既定のマイクがゴーグルのマイクに切り替わることがあります。ゴーグルではなく別のマイクを使いたいときは、SteamVR の設定の「オーディオ」で、SteamVR を使っている間のマイクを選びます。</p>

  <h3 class="section_2__h2">よくある困りごと</h3>
  <div class="case_1">
    <% troubles.forEach(function (c) { %>
      <section class="case_1__item">
        <h4 class="case_1__title"><%= c.title %></h4>
        <p class="case_1__text"><%= c.check %></p>
      </section>
    <% }); %>
  </div>
</section>
