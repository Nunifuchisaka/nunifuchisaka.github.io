      { mark: 2, label: "音量", type: "slider", value: 90, text: "90" },
      { label: "", type: "meter", level: 52, threshold: 0, text: "" },
    ],
  }],
  notes: [
    "<strong>使うマイク</strong>：VRChat で使うマイクを選びます。VRChat の「Microphone」と同じものにしておくと迷いません。",
