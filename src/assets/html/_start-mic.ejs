  screens: [{
    bar: "Settings › Audio & Voice › Microphone",
    label: "VRChat のマイクの設定の再現図。1 使うマイク、2 マイクの音量 100%、3 ノイズの抑制 オン、4 声を拾い始める大きさ 5%、5 ミュートのしかた Toggle",
    rows: [
      { mark: 1, label: "Microphone", type: "select", text: "Headset Microphone (Oculus Virtual Audio Device)" },
