// 再現図（_mock）は本物の画面写真ではなく、説明に要る項目だけを描き直したもの。VRChat の項目名は英語表示のもの
// VRChat の画面や名前は変わるので、名前が違っても「何をする項目か」で探せるように、番号ごとに役目を書く
const route = [
  { head: "マイク", note: "ゴーグルのマイク、ヘッドセット、卓上のマイク" },
  { head: "Windows", note: "使うマイク・入力の音量・マイクへのアクセス許可" },
  { head: "VRChat", note: "使うマイク・音量・ノイズの抑制・拾い始める大きさ・ミュート" },
