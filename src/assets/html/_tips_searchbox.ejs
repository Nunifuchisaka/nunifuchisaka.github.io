<%
// 改変解説の検索窓（小）。押すと /avatar-tips/search/?q=… へ行き、そこで検索する（tips-search.js）
// 使い方：include(path + "assets/html/_tips_searchbox", {searchId: "…"})。searchId はページの中で重ならない id
// 検索はまだ日本語だけなので、日本語のページにだけ置く
%><form class="search_1__form" action="/avatar-tips/search/" method="get" role="search" aria-label="改変解説を検索">
  <label class="filter_1__legend" for="<%= searchId %>">改変解説を検索（全回の本文・用語集・困りごと）</label>
  <div class="search_1__row">
    <input type="search" id="<%= searchId %>" name="q" class="finder_1__input search_1__input" placeholder="例：Write Defaults、表情、ピンク" autocomplete="off" required>
    <button type="submit" class="search_1__button">検索</button>
  </div>
</form>
