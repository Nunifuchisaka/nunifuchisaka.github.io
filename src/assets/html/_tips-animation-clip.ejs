      ["Turning components on and off", "<code>Hat : Enabled</code> (Mesh Renderer and others)", "Hiding only the look. Stopping particles, lights, sound, PhysBones or Contacts", "◯"],
      ["BlendShapes", "<code>Body : Blend Shape.cheek</code>", "Blushing, expressions, body shape", "◯"],
      ["Material values", "<code>Body : Material._Color</code>", "Color, brightness, how it glows. The names differ for each shader", "◯"],
