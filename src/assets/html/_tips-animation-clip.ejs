    none: "書かれない",
    why: "クリップに書かれたパスは {c}、いまの帽子の場所は {p} です。",
    empty: "名前が空です。名前を入れてください。",
    ok: "パスが合っています。クリップが帽子の Is Active を 1 と書くので、帽子が出ます。",
    ng: "パスが合いません。行が黄色くなり Missing! と出ます。クリップは帽子を見つけられないので、帽子は出ません。",
    noJs: "図を動かすには、JavaScript を有効にしてください。",
  },
  casesTitle: "よくある困りごとと直し方",
  caseLabels: { symptom: "起きること", cause: "原因", fix: "直し方" },
  cases: [
    { title: "行が黄色くなり「Missing!」と出る",
      symptom: "Animation ウィンドウで、クリップの行が黄色になり、名前の後ろに (Missing!) と出る。VRChat でもその部分が動かない。",
      cause: "録画したあとで、動かすオブジェクトの名前か場所を変えました。または、録画したときと違う Animator のオブジェクトを選んでいます。",
      fix: "名前と場所を録画したときに戻すか、行を選んで F2 でパスを書き換えます。MA Merge Animator の Path Mode も確かめます。" },
    { title: "録画ボタンが押せない・クリップが出ない",
      symptom: "Animation ウィンドウに、録画ボタンやクリップのプルダウンが出ない。「Create」というボタンだけが出る。",
      cause: "Hierarchy で、Animator コンポーネントが付いたオブジェクトを選んでいないか、その Animator の Controller が空です。",
      fix: "アバターのいちばん上を選び、Animator の Controller にクリップの入ったコントローラーを入れます。ここで Create を押すと、新しいコントローラーが作られて入るので、押さないでおきます。" },
    { title: "関係ないものまで動く",
      symptom: "帽子を出すクリップなのに、再生すると表情や服まで変わる。",
      cause: "録画中に、ほかのオブジェクトや値を触ったため、その行もクリップに入っています。",
      fix: "Animation ウィンドウで要らない行を右クリックして、Remove Properties で消します。" },
    { title: "録画を止めたら、シーンの物まで変わっていた",
      symptom: "クリップには何も入らず、Hierarchy の帽子がオンのままになった。",
      cause: "録画ボタンを押す前に（録画していないときに）値を変えました。録画していないときの変更は、クリップではなく、シーンの物そのものを変えます。",
      fix: "Inspector で元の値に戻します。録画ボタンが赤くなっていることを確かめてから、値を変えます。" },
    { title: "腕や指を動かしたのに、VRChat では動かない",
      symptom: "クリップで腕や指のポーズを作ったが、FX に入れると動かない。",
      cause: "Humanoid の骨（筋肉）は、FX では動きません。",
      fix: `手の形は Gesture、体全体の動きは Action のコントローラーで動かします（${tipLink("animator-basics", "layers")}）。` },
    { title: "色を変えるクリップが効かない",
      symptom: "マテリアルの色を変えるクリップを作ったが、VRChat で色が変わらない。",
      cause: "クリップを作ったあとで、マテリアルのシェーダーを変えたため、同じ名前の値が無くなっています。別のマテリアル（スロット）の値を動かしていることもあります。",
      fix: "いまのシェーダーで、録画し直します。Animation ウィンドウの行が黄色くなっていないかも確かめます。" },
  ],
  careTitle: "気をつけること",
  care: [
    "録画が終わったら、必ず録画ボタンを押して止めます。録画したままほかの作業をすると、触ったものがすべてクリップに入ります。",
    "クリップで使っているオブジェクトの名前や場所は、変えないでおきます。変えるときは、クリップのパスも直します。",
    "録画のためにアバターの Animator に入れたコントローラーは、終わったら元に戻します。",
    "出し入れは Is Active で作ります。大きさを 0 にして隠す方法は、FX で Transform を動かすことになり、VRChat の公式がすすめていません。",
    `オンのクリップとオフのクリップを両方作っておきます。Write Defaults の設定に関係なく、同じように動きます（${tipLink("unity-vs-vrchat", "write-defaults")}）。`,
    "買ったアバターや衣装に付いているクリップを書き換えるときは、先に複製を取っておきます。",
  ],
  sumTitle: "まとめ",
  sum: [
    "クリップには、どのオブジェクト（パス）の何（プロパティ）を、いつ（キー）いくつにするかを書きます。",
    "FX では、オンオフ、BlendShape、マテリアルを動かします。Humanoid の骨は動きません。",
    "Animation ウィンドウの録画で作ります。録画中に触ったものは、すべてクリップに入ります。",
    "オンオフのクリップは、0 と 1 フレーム目に同じ値のキーを打つだけで足ります。",
    "名前や場所を変えるとパスが切れて Missing! と出ます。元に戻すか、F2 でパスを書き換えます。",
    `次は、ここで作ったクリップを使って、メニューでオンオフするギミックを組みます（${tipLink("toggle")}）。`,
  ],
  back: "アバター改変の解説の一覧",
};
const sections = [
  { id: "when", title: l.whenTitle },
  { id: "what", title: l.whatTitle },
  { id: "can", title: l.canTitle },
  { id: "record", title: l.recordTitle },
  { id: "keys", title: l.keysTitle },
  { id: "path", title: l.pathTitle },
  { id: "demo", title: l.demoTitle },
  { id: "cases", title: l.casesTitle },
  { id: "care", title: l.careTitle },
  { id: "summary", title: l.sumTitle },
];
%><article class="article_1" aria-labelledby="article-heading">
  <header class="section_2 page_1 article_1__header">
    <p class="article_1__series"><a href="<%= prefix %>/avatar-tips/"><%= l.series %></a></p>
    <h1 class="page_1__h1" id="article-heading"><%= l.title %></h1>
    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="what" aria-labelledby="what-heading">
    <h2 class="section_2__h1" id="what-heading"><%= l.whatTitle %></h2>
    <% l.what.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <section class="table_3" tabindex="0" aria-label="<%= l.clipTableLabel %>">
      <table>
        <thead>
          <tr><% l.clipHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.clipRows.forEach(function (row) { %>
            <tr><th scope="row"><code><%= row[0] %></code></th><td><%= row[1] %></td><td><%= row[2] %></td><td><%= row[3] %></td><td><%= row[4] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.what2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="can" aria-labelledby="can-heading">
    <h2 class="section_2__h1" id="can-heading"><%= l.canTitle %></h2>
    <% l.can.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <section class="table_3" tabindex="0" aria-label="<%= l.canTableLabel %>">
      <table>
        <thead>
          <tr><% l.canHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.canRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%- row[1] %></td><td><%= row[2] %></td><td><%= row[3] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.can2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="record" aria-labelledby="record-heading">
    <h2 class="section_2__h1" id="record-heading"><%= l.recordTitle %></h2>
    <p class="article_1__p"><%- l.recordLead %></p>
    <h3 class="section_2__h2"><%= l.prepTitle %></h3>
    <ol class="steps_1">
      <% l.prep.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <h3 class="section_2__h2"><%= l.stepsTitle %></h3>
    <ol class="steps_1">
      <% l.steps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.recordMock }) %>
    <% l.record2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="keys" aria-labelledby="keys-heading">
    <h2 class="section_2__h1" id="keys-heading"><%= l.keysTitle %></h2>
    <% l.keys.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="path" aria-labelledby="path-heading">
    <h2 class="section_2__h1" id="path-heading"><%= l.pathTitle %></h2>
    <% l.path.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <%- include("_mock", { mock: l.missingMock }) %>
    <h3 class="section_2__h2"><%= l.fixTitle %></h3>
    <ol class="steps_1">
      <% l.fix.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <h3 class="section_2__h2"><%= l.relTitle %></h3>
    <% l.rel.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="demo" aria-labelledby="demo-heading">
    <h2 class="section_2__h1" id="demo-heading"><%= l.demoTitle %></h2>
    <p class="article_1__p"><%= l.demoLead %></p>
    <div class="demo_2 js_clip_demo" data-clip="<%= l.demo.clipPath %>"
      data-why="<%= l.demo.why %>" data-empty="<%= l.demo.empty %>"
      data-ok="<%= l.demo.ok %>" data-ng="<%= l.demo.ng %>" data-none="<%= l.demo.none %>">
      <div class="demo_2__faces">
        <div class="demo_2__face">
          <p class="demo_2__who"><%= l.demo.window %></p>
          <%- clipRow %>
          <p class="demo_2__num"><%= l.demo.now %> <code class="js_clip_now">Accessories/Hat</code></p>
        </div>
        <div class="demo_2__face">
          <p class="demo_2__who"><%= l.demo.look %></p>
          <%- hatFace(true) %>
          <p class="demo_2__num">Is Active <span class="js_clip_active">1</span></p>
        </div>
      </div>
      <div class="demo_2__controls">
        <div class="demo_1__range">
          <p class="demo_1__label"><label for="clip-name"><%= l.demo.nameLabel %></label></p>
          <input type="text" id="clip-name" class="js_clip_name" value="Hat" autocomplete="off" spellcheck="false">
        </div>
        <fieldset class="demo_1__distance">
          <legend class="demo_1__label"><%= l.demo.parentLegend %></legend>
          <% l.demo.parents.forEach(function (p, i) { %>
            <label><input type="radio" name="clip-parent" value="<%= p.value %>" class="js_clip_parent"<% if (i === 0) { %> checked<% } %>> <%= p.text %></label>
          <% }); %>
        </fieldset>
      </div>
      <div class="demo_2__output" aria-live="polite">
        <p class="demo_1__why js_clip_why"><%= l.demo.why.replace("{c}", l.demo.clipPath).replace("{p}", l.demo.clipPath) %></p>
        <p class="demo_1__result is_ok js_clip_result"><%= l.demo.ok %></p>
      </div>
      <noscript><p class="section_2__note"><%= l.demo.noJs %></p></noscript>
    </div>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%= c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.cause %></dt><dd><%= c.cause %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%- c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%- item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%- item %></li><% }); %>
    </ul>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
