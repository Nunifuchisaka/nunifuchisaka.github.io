// 本文の文字列は code や strong の HTML を含むので、エスケープせずに出す。再現図（_mock）は本物の画面写真ではない
// 英語版は、日本語版の内容が固まってから作る（それまで英語の文は置かない）
const article = avatarTips.articles.find((a) => a.slug === "outfit");
const [py, pm, pd] = article.published.split("-").map(Number);
const published = `${py}年${pm}月${pd}日`;
const newTab = "（新しいタブで開きます）";
const ext = (href, text) => `<a href="${href}" target="_blank" rel="noopener">${text}<span class="visually-hidden">${newTab}</span></a>`;
const maDocs = "https://modular-avatar.nadena.dev/ja/docs/intro";

// 動く図の絵。s は体の縮小（Shrink）の値（0〜100）。0 で体がいちばん太く、100 で細くなる
// 服の幅（半分）は 46。体の幅（半分）は 52 から 38 まで変わり、46 を超えると服から突き抜ける
const bodyRx = (s) => (52 - 14 * (s / 100)).toFixed(2);
const figure = (s, wear) => `<svg class="demo_2__svg" viewBox="0 0 200 150" aria-hidden="true" focusable="false">`
  + `<circle cx="100" cy="26" r="16" fill="#f6dcc8" stroke="#8a5a44" stroke-width="2"/>`
  + `<ellipse class="js_outfit_body" cx="100" cy="92" rx="${bodyRx(s)}" ry="42" fill="#f6dcc8" stroke="#8a5a44" stroke-width="2"/>`
  + (wear ? `<rect x="54" y="46" width="92" height="94" rx="18" fill="#6f8fd6" stroke="#34508f" stroke-width="2"/>`
    + `<path d="M84 46 L100 64 L116 46" fill="none" stroke="#34508f" stroke-width="2"/>` : "")
  + `</svg>`;

