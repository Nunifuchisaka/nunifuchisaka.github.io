    modes: [
      { value: "size", text: "大きさ（Scale 0.5 → 1.5）" },
      { value: "color", text: "色（青 → 赤）" },
    ],
    frame: "HatSize が {v} なので、60 フレームのクリップの {f} フレーム目の値が使われます。",
    size: "帽子の Scale は {x} です。",
    color: "帽子の色は、青から赤へ {p}% 進んだところです。",
    remote: "ほかの人に届く値は、目安で {r} です（8 bit に丸められるため）。",
