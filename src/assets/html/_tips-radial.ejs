  casesTitle: "よくある困りごとと直し方",
  caseLabels: { symptom: "起きること", cause: "原因", fix: "直し方" },
  cases: [
    { title: "2着が同時に出る",
      symptom: "別の服を選んだのに、前の服が消えずに重なる。",
      cause: "クリップに、ほかの服の行（Is Active が 0）が入っていません。Write Defaults が OFF なので、前の値が残っています。",
      fix: "Outfit_0〜Outfit_3 のどのクリップにも、3着すべての Is Active の行を入れます。" },
    { title: "選んでも切り替わらない",
      symptom: "メニューで服を押しても、何も変わらない。",
      cause: "Animator のパラメーターの名前か型（Int）が違うか、Any State からの矢印の Equals の数が違います。レイヤーの Weight が 0 のこともあります。",
      fix: "名前と型を、MA Parameters と Animator でそろえます。矢印の数と、メニューの Value が合っているかを確かめます。" },
    { title: "動きのあるクリップが最初から再生され続ける",
      symptom: "選んだ服に揺れなどのアニメーションを付けたら、ずっと最初の形で止まって見える。",
      cause: "Any State からの矢印で、Can Transition To Self にチェックが入っています。毎フレーム入り直しています。",
