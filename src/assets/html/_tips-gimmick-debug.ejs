const sections = [
  { id: "when", title: l.whenTitle },
  { id: "order", title: l.orderTitle },
  { id: "tools", title: l.toolsTitle },
  { id: "checklist", title: l.checklistTitle },
  { id: "cases", title: l.casesTitle },
  { id: "care", title: l.careTitle },
  { id: "summary", title: l.sumTitle },
];
%><article class="article_1" aria-labelledby="article-heading">
  <header class="section_2 page_1 article_1__header">
    <p class="article_1__series"><a href="<%= prefix %>/avatar-tips/"><%= l.series %></a></p>
    <h1 class="page_1__h1" id="article-heading"><%= l.title %></h1>
    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="order" aria-labelledby="order-heading">
    <h2 class="section_2__h1" id="order-heading"><%= l.orderTitle %></h2>
    <% l.orderLead.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <ol class="route_1">
      <% l.route.forEach(function (step) { %>
        <li class="route_1__step"><span class="route_1__head"><%= step.head %></span><span class="route_1__note"><%= step.note %></span></li>
      <% }); %>
    </ol>
    <h3 class="section_2__h2"><%= l.orderStepsTitle %></h3>
    <dl class="examples_1">
      <% l.orderSteps.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%- item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <p class="section_2__note"><%= l.orderNote %></p>
  </section>

  <section class="section_2 article_1__section" id="tools" aria-labelledby="tools-heading">
    <h2 class="section_2__h1" id="tools-heading"><%= l.toolsTitle %></h2>
    <p class="article_1__p"><%= l.toolsLead %></p>

    <h3 class="section_2__h2"><%= l.gmTitle %></h3>
    <% l.gmLead.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <ol class="steps_1">
      <% l.gmSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.gmMock }) %>
    <p class="section_2__note"><%= l.gmNote %></p>

    <h3 class="section_2__h2"><%= l.animTitle %></h3>
    <ol class="steps_1">
      <% l.animSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <p class="section_2__note"><%= l.animNote %></p>

    <h3 class="section_2__h2"><%= l.vrcTitle %></h3>
    <% l.vrc.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="checklist" aria-labelledby="checklist-heading">
    <h2 class="section_2__h1" id="checklist-heading"><%= l.checklistTitle %></h2>
    <p class="article_1__p"><%= l.checklistLead %></p>
    <div class="demo_2__controls js_debug_picker" data-target="debug-checklist"
      data-all="<%= l.picker.countAll %>" data-some="<%= l.picker.countSome %>" hidden>
      <fieldset class="demo_1__distance">
        <legend class="demo_1__label"><%= l.picker.legend %></legend>
        <label><input type="radio" name="debug-symptom" value="all" class="js_debug_symptom" checked> <%= l.picker.all %></label>
        <% l.symptoms.forEach(function (s) { %>
          <label><input type="radio" name="debug-symptom" value="<%= s.id %>" class="js_debug_symptom"> <%= s.text %></label>
        <% }); %>
      </fieldset>
      <p class="demo_1__why js_debug_count" aria-live="polite"><%= l.picker.countAll.replace("{n}", String(l.rows.length)) %></p>
    </div>
    <noscript><p class="section_2__note"><%= l.picker.noJs %></p></noscript>
    <section class="table_3" id="debug-checklist" tabindex="0" aria-label="<%= l.tableLabel %>">
      <table>
        <thead>
          <tr><% l.tableHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.rows.forEach(function (row) { %>
            <tr data-symptoms="<%= row.s %>"><th scope="row"><%= row.symptom %></th><td><%- row.cause %></td><td><%- row.fix %><ul class="table_3__list"><% row.see.forEach(function (a) { %><li><%- a %></li><% }); %></ul></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%= c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.cause %></dt><dd><%= c.cause %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%= c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%- item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
