%><section class="section_2 page_1" aria-labelledby="claude-heading">
  <h1 class="page_1__h1" id="claude-heading"><%= l.title %></h1>
  <p class="section_2__lead"><%= l.lead %></p>
</section>

<section class="section_2" aria-labelledby="setup-heading">
  <h2 class="section_2__h1" id="setup-heading"><%= l.setupTitle %></h2>
  <div class="team_1">
    <div class="team_1__node team_1__node--me">
      <p class="team_1__name"><%= l.me %></p>
      <p class="team_1__note"><%= l.meNote %></p>
    </div>
    <div class="team_1__link" aria-hidden="true"></div>
    <div class="team_1__node team_1__node--hub">
      <p class="team_1__name"><%= l.hub %></p>
      <p class="team_1__note"><%= l.hubNote %></p>
    </div>
    <div class="team_1__link" aria-hidden="true"></div>
    <div class="team_1__groups">
      <div class="team_1__group">
        <h3 class="team_1__h"><%= l.agentsTitle %></h3>
        <ul>
          <% l.agents.forEach(function (agent) { %>
            <li class="team_1__node">
              <p class="team_1__name"><%= agent.name %> <span class="team_1__role"><%= agent.role %></span></p>
              <p class="team_1__note"><%= agent.note %></p>
            </li>
          <% }); %>
        </ul>
      </div>
      <div class="team_1__group">
        <h3 class="team_1__h"><%= l.skillsTitle %></h3>
        <ul>
          <% l.skills.forEach(function (skill) { %>
            <li class="team_1__node">
              <p class="team_1__name" lang="en"><%= skill.name %></p>
              <p class="team_1__note"><%= skill.note %></p>
            </li>
          <% }); %>
        </ul>
      </div>
      <div class="team_1__group">
        <h3 class="team_1__h"><%= l.memoryTitle %></h3>
        <ul>
          <li class="team_1__node">
            <p class="team_1__name" lang="en"><%= l.memory.name %></p>
            <p class="team_1__note"><%= l.memory.note %></p>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section_2" aria-labelledby="flow-heading">
  <h2 class="section_2__h1" id="flow-heading"><%= l.flowTitle %></h2>
  <ol class="flow_1">
    <% l.flow.forEach(function (step) { %>
      <li class="flow_1__step">
        <p class="flow_1__who"><%= step.who %></p>
        <p class="flow_1__title"><%= step.title %></p>
        <p class="flow_1__note"><%= step.note %></p>
      </li>
    <% }); %>
  </ol>
</section>

<section class="section_2" aria-labelledby="asset-flow-heading">
  <h2 class="section_2__h1" id="asset-flow-heading"><%= l.assetFlowTitle %></h2>
  <p class="section_2__lead"><%= l.assetFlowLead %></p>
  <ol class="flow_1">
    <% l.assetFlow.forEach(function (step) { %>
      <li class="flow_1__step">
        <p class="flow_1__who"><%= step.who %></p>
        <p class="flow_1__title"><%= step.title %></p>
        <p class="flow_1__note"><%= step.note %></p>
      </li>
    <% }); %>
  </ol>
</section>

<section class="section_2" aria-labelledby="rules-heading">
  <h2 class="section_2__h1" id="rules-heading"><%= l.rulesTitle %></h2>
  <ul class="rules_1">
    <% l.rules.forEach(function (rule) { %>
      <li><%= rule %></li>
    <% }); %>
  </ul>
</section>

<section class="section_2" aria-labelledby="examples-heading">
  <h2 class="section_2__h1" id="examples-heading"><%= l.examplesTitle %></h2>
  <dl class="examples_1">
    <% l.examples.forEach(function (example) { %>
      <div class="examples_1__item">
        <dt><%= example.title %></dt>
        <dd><%= example.note %></dd>
      </div>
    <% }); %>
  </dl>
</section>
