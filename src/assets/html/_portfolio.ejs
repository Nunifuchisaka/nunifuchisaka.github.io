<%
const pageLocale = typeof locale !== "undefined" ? locale : "ja";
const newTab = pageLocale === "en" ? "(opens in a new tab)" : "（新しいタブで開きます）";
const heading = pageLocale === "en" ? "Things I made" : "つくったもの";
%><section id="portfolio" class="section_2" aria-labelledby="portfolio-heading">
  <h2 class="section_2__h1" id="portfolio-heading"><%= heading %></h2>
  <ul class="list_9">
    <%
    const portfolio = [
      {
        title: "桜兎フルガ 公式サイト",
        eyecatch: "otofuruga.webp",
        url: "https://otofuruga.pink/",
      },
      {
        title: "DeepFrostIce",
        eyecatch: "deepfrostice.webp",
        url: "https://nunifuchisaka.github.io/deepfrostice/",
      },
      {
        title: "HeartBeat",
        eyecatch: "heartbeat.jpg",
        url: "https://nunifuchisaka.github.io/heartbeat/",
      },
      {
        title: "SpiderWeb",
        eyecatch: "spiderweb.webp",
        url: "https://nunifuchisaka.github.io/spiderweb/",
      },
      {
        title: "ImageGetter",
        eyecatch: "imagegetter.webp",
        url: "https://nunifuchisaka.github.io/imagegetter/",
      },
      {
        title: "GlossySkin",
        eyecatch: "glossyskin.webp",
        url: "https://nunifuchisaka.github.io/glossyskin/",
      },
      {
        title: "DeskCinema",
        eyecatch: "deskcinema.png",
        url: "https://nunifuchisaka.github.io/deskcinema/",
      },
      {
        title: "NuniAvatarToolkit",
        eyecatch: "nuniavatartoolkit.svg",
        url: "https://nunifuchisaka.github.io/nuniavatartoolkit/",
      },
      {
        title: "PublicWalker",
        eyecatch: "publicwalker.svg",
        url: "https://nunifuchisaka.github.io/publicwalker/",
      },
    ];
    portfolio.forEach(function (value, key) { %>
      <li>
        <a href="<%= value.url %>" target="_blank" rel="noopener">
          <img src="/assets/img/<%= value.eyecatch %>" alt="" loading="lazy">
          <span class="list_9__title"><%= value.title %><span class="visually-hidden"><%= newTab %></span></span>
        </a>
      </li>
    <% }); %>
  </ul><!-- /.list_9 -->
</section><!-- /#portfolio.section_2 -->