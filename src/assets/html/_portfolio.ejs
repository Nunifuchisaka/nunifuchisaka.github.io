<section id="portfolio" class="section_1">
  <h2 class="section_1__h1">
    Portfolio
  </h2>
  <ul class="list_3">
    <%
    const portfolio = [
      {
        title: "桜兎フルガ 公式サイト",
        eyecatch: "otofuruga.webp",
        url: "https://otofuruga.pink/",
      },
      {
        title: "DeepFrostIce",
        eyecatch: "deepfrostice.webp",
        url: "https://nunifuchisaka.github.io/deepfrostice/",
      },
      {
        title: "HeartBeat",
        eyecatch: "heartbeat.jpg",
        url: "https://nunifuchisaka.github.io/heartbeat/",
      },
      {
        title: "ImageGetter",
        eyecatch: "imagegetter.webp",
        url: "https://nunifuchisaka.github.io/imagegetter/",
      },
      {
        title: "GlossySkin",
        eyecatch: "glossyskin.webp",
        url: "https://nunifuchisaka.github.io/glossyskin/",
      },
    ];
    portfolio.forEach(function (value, key) { %>
      <li>
        <a href="<%= value.url %>" target="_blank" rel="noopener">
          <img src="assets/img/<%= value.eyecatch %>" alt="<%= value.title %>">
          <p><%= value.title %><span class="visually-hidden">（新しいタブで開きます）</span></p>
        </a>
      </li>
    <% }); %>
  </ul><!-- /.list_3 -->
</section><!-- /#portfolio.section_1 -->