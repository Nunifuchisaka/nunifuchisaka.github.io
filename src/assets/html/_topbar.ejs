<%
const pageLocale = typeof locale !== "undefined" ? locale : "ja";
// current：いま開いているページ（"home" / "start" / "timeline" / "equipment" / "products" / "videos" / "dice" / "cluster" / "claude-code" / "faq" / "worlds" / "avatar-tips"）。aria-current を付ける
const currentPage = typeof current !== "undefined" ? current : "home";
// cluster のページはナビに出さず、トップページの「cluster」から行く
// よくある質問は「制作物」の、お気に入りワールドは「はじめてのVRChat」の下のページとして、ナビではその親に印を付ける
// enReady：false のページは英語版がまだ無い（日本語版の内容が固まってから作る）。言語切替の English を選べないようにする
const hasEn = typeof enReady === "undefined" ? true : enReady;
// 英語版がまだ無い項目は、英語のメニューに出さない
const EN_PENDING = [];
const navPage = { faq: "products", worlds: "start", "avatar-tips-article": "avatar-tips" }[currentPage] || currentPage;
const isEn = pageLocale === "en";
const t = {
  ja: {
    name: "ぬにふちさか",
    navLabel: "サイト内",
    start: "はじめてのVRChat",
    products: "制作物",
    avatarTips: "改変解説",
    timeline: "案内実績",
    equipment: "VR機材",
    videos: "回想",
    dice: "話題サイコロ",
    claudeCode: "Claude Code",
    langLabel: "言語切替",
    enPending: "（準備中）",
    toDark: "ダークにする",
    toLight: "ライトにする",
  },
  en: {
    name: "Nunifuchisaka",
    navLabel: "Site",
    start: "Getting started",
    products: "Products",
    avatarTips: "Avatar Tips",
    timeline: "Guide Log",
    equipment: "VR Gear",
    videos: "Memories",
    dice: "Topic Dice",
    claudeCode: "Claude Code",
    langLabel: "Language",
    enPending: " (coming soon)",
    toDark: "Switch to dark",
    toLight: "Switch to light",
  },
};
const l = t[pageLocale];
const prefix = isEn ? "/en" : "";
%><header class="header_4">
  <div class="header_4__inner">
    <a class="header_4__home" href="<%= prefix %>/"<% if (currentPage === "home") { %> aria-current="page"<% } %>><%= l.name %></a>
    <nav class="header_4__nav" aria-label="<%= l.navLabel %>">
      <ul>
        <% [["start", l.start], ["timeline", l.timeline], ["equipment", l.equipment], ["products", l.products], ["avatar-tips", l.avatarTips], ["videos", l.videos], ["dice", l.dice], ["claude-code", l.claudeCode]].filter((item) => !isEn || !EN_PENDING.includes(item[0])).forEach(function (item) { %>
          <li><a href="<%= prefix %>/<%= item[0] %>/"<% if (currentPage === item[0]) { %> aria-current="page"<% } else if (navPage === item[0]) { %> aria-current="true"<% } %>><%= item[1] %></a></li>
        <% }); %>
      </ul>
    </nav>
    <div class="header_4__tools">
      <label class="visually-hidden" for="js-lang-select"><%= l.langLabel %></label>
      <select class="header_4__select" id="js-lang-select">
        <option value="ja"<% if (!isEn) { %> selected<% } %>>日本語</option>
        <option value="en"<% if (isEn) { %> selected<% } %><% if (!hasEn) { %> disabled<% } %>>English<% if (!hasEn) { %><%= l.enPending %><% } %></option>
      </select>
      <button type="button" class="header_4__theme js_theme_toggle" data-label-dark="<%= l.toDark %>" data-label-light="<%= l.toLight %>"><%= l.toDark %></button>
    </div>
  </div>
</header><!-- /.header_4 -->
