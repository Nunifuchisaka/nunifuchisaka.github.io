// 動く図の最初の状態：左手 Victory（4）、右手 Neutral（0）、右手が下、下の Neutral は Face_None
const first = { left: gestures[4], right: gestures[0] };
const sections = [
  { id: "when", title: l.whenTitle },
  { id: "plan", title: l.planTitle },
  { id: "numbers", title: l.numbersTitle },
  { id: "clips", title: l.clipsTitle },
  { id: "layers", title: l.layersTitle },
  { id: "build", title: l.buildTitle },
  { id: "transitions", title: l.transitionsTitle },
  { id: "demo", title: l.demoTitle },
  { id: "tracking", title: l.trackingTitle },
  { id: "weight", title: l.weightTitle },
  { id: "lock", title: l.lockTitle },
  { id: "test", title: l.testTitle },
  { id: "cases", title: l.casesTitle },
  { id: "care", title: l.careTitle },
  { id: "summary", title: l.sumTitle },
];
%><article class="article_1" aria-labelledby="article-heading">
  <header class="section_2 page_1 article_1__header">
    <p class="article_1__series"><a href="<%= prefix %>/avatar-tips/"><%= l.series %></a></p>
    <h1 class="page_1__h1" id="article-heading"><%= l.title %></h1>
    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="plan" aria-labelledby="plan-heading">
    <h2 class="section_2__h1" id="plan-heading"><%= l.planTitle %></h2>
    <p class="article_1__p"><%- l.planLead %></p>
    <dl class="examples_1 examples_1--grid">
      <% l.plan.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%= item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <% l.planNote.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="numbers" aria-labelledby="numbers-heading">
    <h2 class="section_2__h1" id="numbers-heading"><%= l.numbersTitle %></h2>
    <% l.numbersLead.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <section class="table_3" tabindex="0" aria-label="<%= l.numbersTableLabel %>">
      <table>
        <thead>
          <tr><% l.numbersHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% gestures.forEach(function (g) { %>
            <tr><th scope="row" class="table_3__nowrap"><%= g.no %></th><td class="table_3__nowrap"><%= g.name %></td><td><%= g.hand %></td><td><%= g.face %>（<%= g.clip %>）</td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.numbersNotes.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="clips" aria-labelledby="clips-heading">
    <h2 class="section_2__h1" id="clips-heading"><%= l.clipsTitle %></h2>
    <p class="article_1__p"><%- l.clipsLead %></p>
    <ol class="steps_1">
      <% l.clips.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.clipMock }) %>
    <p class="article_1__p"><%- l.clipsMore %></p>
  </section>

  <section class="section_2 article_1__section" id="layers" aria-labelledby="layers-heading">
    <h2 class="section_2__h1" id="layers-heading"><%= l.layersTitle %></h2>
    <% l.layers.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <section class="table_3" tabindex="0" aria-label="<%= l.layersTableLabel %>">
      <table>
        <thead>
          <tr><% l.layersHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.layersRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%= row[1] %></td><td><%= row[2] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.layers2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <h3 class="section_2__h2"><%= l.chooseTitle %></h3>
    <dl class="examples_1 examples_1--grid">
      <% l.choose.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%= item.body %></dd>
        </div>
      <% }); %>
    </dl>
  </section>

  <section class="section_2 article_1__section" id="build" aria-labelledby="build-heading">
    <h2 class="section_2__h1" id="build-heading"><%= l.buildTitle %></h2>
    <p class="article_1__p"><%- l.buildLead %></p>
    <ol class="steps_1">
      <% l.build.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="transitions" aria-labelledby="transitions-heading">
    <h2 class="section_2__h1" id="transitions-heading"><%= l.transitionsTitle %></h2>
    <p class="article_1__p"><%= l.transitionsLead %></p>
    <ol class="steps_1">
      <% l.transitions.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.transitionMock }) %>
    <p class="article_1__p"><%- l.transitionsMore %></p>
  </section>

  <section class="section_2 article_1__section" id="demo" aria-labelledby="demo-heading">
    <h2 class="section_2__h1" id="demo-heading"><%= l.demoTitle %></h2>
    <p class="article_1__p"><%= l.demoLead %></p>
    <div class="demo_2 js_gesture_demo"
      data-hand-left="<%= l.demo.leftHand %>" data-hand-right="<%= l.demo.rightHand %>"
      data-upper="<%= l.demo.upper %>" data-lower="<%= l.demo.lower %>" data-layer="<%= l.demo.layerSuffix %>" data-pass="<%= l.demo.pass %>"
      data-why-lower="<%= l.demo.whyLower %>" data-why-hidden="<%= l.demo.whyHidden %>"
      data-why-pass="<%= l.demo.whyPass %>" data-why-reset="<%= l.demo.whyReset %>"
      data-ok="<%= l.demo.ok %>" data-ng="<%= l.demo.ng %>">
      <div class="demo_2__faces">
        <div class="demo_2__face">
          <p class="demo_2__who js_gesture_who" data-face="left"><%= l.demo.leftHand %><%= l.demo.layerSuffix %><%= l.demo.upper %></p>
          <div class="js_gesture_face" data-face="left"><%- face(first.left.expr, false) %></div>
          <p class="demo_2__num js_gesture_num" data-face="left"><%= first.left.face %></p>
        </div>
        <div class="demo_2__face">
          <p class="demo_2__who js_gesture_who" data-face="right"><%= l.demo.rightHand %><%= l.demo.layerSuffix %><%= l.demo.lower %></p>
          <div class="js_gesture_face" data-face="right"><%- face("neutral", true) %></div>
          <p class="demo_2__num js_gesture_num" data-face="right"><%= l.demo.pass %></p>
        </div>
      </div>
      <div class="demo_2__controls">
        <div class="demo_1__range">
          <p class="demo_1__label"><label for="gesture-left"><%= l.demo.left %></label></p>
          <select id="gesture-left" class="js_gesture_left">
            <% gestures.forEach(function (g) { %><option value="<%= g.no %>" data-expr="<%= g.expr %>" data-face="<%= g.face %>"<% if (g.no === first.left.no) { %> selected<% } %>><%= g.no %> <%= g.name %> → <%= g.face %></option><% }); %>
          </select>
        </div>
        <div class="demo_1__range">
          <p class="demo_1__label"><label for="gesture-right"><%= l.demo.right %></label></p>
          <select id="gesture-right" class="js_gesture_right">
            <% gestures.forEach(function (g) { %><option value="<%= g.no %>" data-expr="<%= g.expr %>" data-face="<%= g.face %>"<% if (g.no === first.right.no) { %> selected<% } %>><%= g.no %> <%= g.name %> → <%= g.face %></option><% }); %>
          </select>
        </div>
        <fieldset class="demo_1__distance">
          <legend class="demo_1__label"><%= l.demo.order %></legend>
          <label><input type="radio" name="gesture-order" value="right" class="js_gesture_order" checked> <%= l.demo.rightHand %><%= l.demo.layerSuffix %></label>
          <label><input type="radio" name="gesture-order" value="left" class="js_gesture_order"> <%= l.demo.leftHand %><%= l.demo.layerSuffix %></label>
        </fieldset>
        <fieldset class="demo_1__distance">
          <legend class="demo_1__label"><%= l.demo.neutral %></legend>
          <% l.demo.neutrals.forEach(function (n, i) { %>
            <label><input type="radio" name="gesture-neutral" value="<%= n.value %>" class="js_gesture_neutral"<% if (i === 0) { %> checked<% } %>> <%= n.text %></label>
          <% }); %>
        </fieldset>
      </div>
      <div class="demo_2__output" aria-live="polite">
        <div class="demo_2__face">
          <p class="demo_2__who"><%= l.demo.view %></p>
          <div class="js_gesture_face" data-face="view"><%- face(first.left.expr, false) %></div>
        </div>
        <p class="demo_1__why js_gesture_why"><%= l.demo.whyPass.replace("{l}", l.demo.rightHand).replace("{u}", l.demo.leftHand).replace("{e}", first.left.face) %></p>
        <p class="demo_1__result is_ok js_gesture_result"><%= l.demo.ok.replace("{e}", first.left.face).replace("{w}", l.demo.leftHand) %></p>
      </div>
      <noscript><p class="section_2__note"><%= l.demo.noJs %></p></noscript>
    </div>
  </section>

  <section class="section_2 article_1__section" id="tracking" aria-labelledby="tracking-heading">
    <h2 class="section_2__h1" id="tracking-heading"><%= l.trackingTitle %></h2>
    <% l.tracking.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <ol class="steps_1">
      <% l.trackingSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.trackingMock }) %>
    <p class="article_1__p"><%- l.trackingNote %></p>
  </section>

  <section class="section_2 article_1__section" id="weight" aria-labelledby="weight-heading">
    <h2 class="section_2__h1" id="weight-heading"><%= l.weightTitle %></h2>
    <% l.weight.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <ol class="steps_1">
      <% l.weightSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <p class="article_1__p"><%= l.weightNote %></p>
  </section>

  <section class="section_2 article_1__section" id="lock" aria-labelledby="lock-heading">
    <h2 class="section_2__h1" id="lock-heading"><%= l.lockTitle %></h2>
    <p class="article_1__p"><%= l.lockLead %></p>
    <ol class="steps_1">
      <% l.lock.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="test" aria-labelledby="test-heading">
    <h2 class="section_2__h1" id="test-heading"><%= l.testTitle %></h2>
    <ol class="steps_1">
      <% l.test.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%= c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.cause %></dt><dd><%= c.cause %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%= c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
    <p class="article_1__p"><%- l.casesMore %></p>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
