<%
// アバター改変の解説の各回の下に置く、前の回・次の回への案内。slug は いまの回。順番は avatar-tips.json の no
// 日本語のページでは、VRChat 用語集への案内と、改変解説の検索窓も出す（英語版ができたら英語でも出す）
const pageLocale = typeof locale !== "undefined" ? locale : "ja";
const prefix = pageLocale === "en" ? "/en" : "";
const articles = [...avatarTips.articles].sort((a, b) => a.no - b.no);
const at = articles.findIndex((a) => a.slug === slug);
const prev = articles[at - 1];
const next = articles[at + 1];
const l = {
  ja: { label: "前後の回", prev: "前の回", next: "次の回", no: (n) => `第${n}回`, open: "（", close: "）" },
  en: { label: "Previous and next tips", prev: "Previous", next: "Next", no: (n) => `#${n}`, open: " (", close: ")" },
}[pageLocale];
%><nav class="section_2 article_1__pager" aria-label="<%= l.label %>">
  <% if (pageLocale === "ja") { %><p class="section_2__note">わからない言葉は「<a href="/glossary/">VRChat 用語集</a>」で調べられます。本文の色と点線の付いた言葉は、マウスを乗せると短い説明が出ます。</p>
  <%- include("_tips_searchbox", {searchId: "tips-site-search"}) %><% } %>
  <ul class="next_1 next_1--pager">
    <% if (prev) { %>
      <li class="next_1__prev"><a href="<%= prefix %>/avatar-tips/<%= prev.slug %>/" rel="prev"><span class="next_1__note"><%= l.prev %><%= l.open %><%= l.no(prev.no) %><%= l.close %></span><span class="next_1__text"><%= prev.title[pageLocale] %></span></a></li>
    <% } %>
    <% if (next) { %>
      <li class="next_1__next"><a href="<%= prefix %>/avatar-tips/<%= next.slug %>/" rel="next"><span class="next_1__note"><%= l.next %><%= l.open %><%= l.no(next.no) %><%= l.close %></span><span class="next_1__text"><%= next.title[pageLocale] %></span></a></li>
    <% } %>
  </ul>
</nav>
