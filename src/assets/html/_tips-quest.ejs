const sections = [
  { id: "when", title: l.whenTitle },
  { id: "why", title: l.whyTitle },
  { id: "see", title: l.seeTitle },
  { id: "limits", title: l.limitsTitle },
  { id: "shaders", title: l.shadersTitle },
  { id: "ranks", title: l.ranksTitle },
  { id: "first", title: l.firstTitle },
  { id: "steps", title: l.stepsTitle },
  { id: "tools", title: l.toolsTitle },
  { id: "same", title: l.sameTitle },
  { id: "ios", title: l.iosTitle },
  { id: "cases", title: l.casesTitle },
  { id: "care", title: l.careTitle },
  { id: "summary", title: l.sumTitle },
];
%><article class="article_1" aria-labelledby="article-heading">
  <header class="section_2 page_1 article_1__header">
    <p class="article_1__series"><a href="<%= prefix %>/avatar-tips/"><%= l.series %></a></p>
    <h1 class="page_1__h1" id="article-heading"><%= l.title %></h1>
    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="why" aria-labelledby="why-heading">
    <h2 class="section_2__h1" id="why-heading"><%= l.whyTitle %></h2>
    <% l.why.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="see" aria-labelledby="see-heading">
    <h2 class="section_2__h1" id="see-heading"><%= l.seeTitle %></h2>
    <dl class="examples_1 examples_1--grid">
      <% l.see.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%- item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <p class="section_2__note"><%- ext(links.impostors, l.docImpostors) %></p>
  </section>

  <section class="section_2 article_1__section" id="limits" aria-labelledby="limits-heading">
    <h2 class="section_2__h1" id="limits-heading"><%= l.limitsTitle %></h2>
    <p class="article_1__p"><%= l.limitsLead %></p>
    <ul class="rules_1">
      <% l.limits.forEach(function (item) { %><li><%- item %></li><% }); %>
    </ul>
    <p class="section_2__note"><%- ext(links.limits, l.docLimits) %></p>
  </section>

  <section class="section_2 article_1__section" id="shaders" aria-labelledby="shaders-heading">
    <h2 class="section_2__h1" id="shaders-heading"><%= l.shadersTitle %></h2>
    <section class="table_3" tabindex="0" aria-label="<%= l.shadersTableLabel %>">
      <table>
        <thead>
          <tr><% l.shadersHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.shadersRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%= row[1] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <p class="article_1__p"><%= l.shadersNote %></p>
    <%- include("_mock", { mock: l.shaderMock }) %>
  </section>

  <section class="section_2 article_1__section" id="ranks" aria-labelledby="ranks-heading">
    <h2 class="section_2__h1" id="ranks-heading"><%= l.ranksTitle %></h2>
    <% l.ranks.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <section class="table_3" tabindex="0" aria-label="<%= l.ranksTableLabel %>">
      <table>
        <thead>
          <tr><% l.ranksHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.ranksRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%= row[1] %></td><td><%= row[2] %></td><td><%= row[3] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <p class="article_1__p"><%= l.ranksNote %><a href="<%= l.ranksLink.href %>"><%= l.ranksLink.text %></a><%= l.ranksNote2 %></p>
    <p class="section_2__note"><%- ext(links.ranks, l.docRanks) %></p>
  </section>

  <section class="section_2 article_1__section" id="first" aria-labelledby="first-heading">
    <h2 class="section_2__h1" id="first-heading"><%= l.firstTitle %></h2>
    <% l.first.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="steps" aria-labelledby="steps-heading">
    <h2 class="section_2__h1" id="steps-heading"><%= l.stepsTitle %></h2>
    <ol class="steps_1">
      <% l.steps.forEach(function (step) { %>
        <% if (typeof step === "object") { %>
          <li><%- step.html %><a href="<%= l.stepsHubLink.href %>"><%= l.stepsHubLink.text %></a><%= l.stepsHubAfter %></li>
        <% } else { %>
          <li><%- step %></li>
        <% } %>
      <% }); %>
    </ol>
    <%- include("_mock", { mock: l.sdkMock }) %>
  </section>

  <section class="section_2 article_1__section" id="tools" aria-labelledby="tools-heading">
    <h2 class="section_2__h1" id="tools-heading"><%= l.toolsTitle %></h2>
    <ul class="rules_1">
      <% l.tools.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="same" aria-labelledby="same-heading">
    <h2 class="section_2__h1" id="same-heading"><%= l.sameTitle %></h2>
    <ul class="rules_1">
      <% l.same.forEach(function (item) { %><li><%- item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="ios" aria-labelledby="ios-heading">
    <h2 class="section_2__h1" id="ios-heading"><%= l.iosTitle %></h2>
    <% l.ios.forEach(function (text) { %><p class="article_1__p"><%= text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%= c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.cause %></dt><dd><%= c.cause %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%= c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
