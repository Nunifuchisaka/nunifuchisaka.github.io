const sections = [
  { id: "when", title: l.whenTitle },
  { id: "parts", title: l.partsTitle },
  { id: "choose", title: l.chooseTitle },
  { id: "prep", title: l.prepTitle },
  { id: "vcc", title: l.vccTitle },
  { id: "license", title: l.licenseTitle },
  { id: "alcom", title: l.alcomTitle },
  { id: "hub", title: l.hubTitle },
  { id: "mac", title: l.macTitle },
  { id: "project", title: l.projectTitle },
  { id: "packages", title: l.packagesTitle },
  { id: "cases", title: l.casesTitle },
  { id: "care", title: l.careTitle },
  { id: "summary", title: l.sumTitle },
];
%><article class="article_1" aria-labelledby="article-heading">
  <header class="section_2 page_1 article_1__header">
    <p class="article_1__series"><a href="<%= prefix %>/avatar-tips/"><%= l.series %></a></p>
    <h1 class="page_1__h1" id="article-heading"><%= l.title %></h1>
    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="parts" aria-labelledby="parts-heading">
    <h2 class="section_2__h1" id="parts-heading"><%= l.partsTitle %></h2>
    <p class="article_1__p"><%= l.partsLead %></p>
    <dl class="examples_1 examples_1--grid">
      <% l.parts.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%- item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <ol class="route_1">
      <% l.route.forEach(function (step) { %>
        <li class="route_1__step"><span class="route_1__head"><%= step.head %></span><span class="route_1__note"><%= step.note %></span></li>
      <% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="choose" aria-labelledby="choose-heading">
    <h2 class="section_2__h1" id="choose-heading"><%= l.chooseTitle %></h2>
    <section class="table_3" tabindex="0" aria-label="<%= l.chooseTableLabel %>">
      <table>
        <thead>
          <tr><% l.chooseHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.chooseRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%= row[1] %></td><td><%= row[2] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.choose.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="prep" aria-labelledby="prep-heading">
    <h2 class="section_2__h1" id="prep-heading"><%= l.prepTitle %></h2>
    <ul class="rules_1">
      <% l.prep.forEach(function (item) { %><li><%- item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="vcc" aria-labelledby="vcc-heading">
    <h2 class="section_2__h1" id="vcc-heading"><%= l.vccTitle %></h2>
    <p class="article_1__p"><%= l.vccLead %></p>
    <ol class="steps_1">
      <% l.vccSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.vccMock }) %>
  </section>

  <section class="section_2 article_1__section" id="license" aria-labelledby="license-heading">
    <h2 class="section_2__h1" id="license-heading"><%= l.licenseTitle %></h2>
    <% l.license.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="alcom" aria-labelledby="alcom-heading">
    <h2 class="section_2__h1" id="alcom-heading"><%= l.alcomTitle %></h2>
    <p class="article_1__p"><%= l.alcomLead %></p>
    <ol class="steps_1">
      <% l.alcomSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.alcomMock }) %>
  </section>

  <section class="section_2 article_1__section" id="hub" aria-labelledby="hub-heading">
    <h2 class="section_2__h1" id="hub-heading"><%= l.hubTitle %></h2>
    <p class="article_1__p"><%- l.hubLead %></p>
    <ol class="steps_1">
      <% l.hubSteps.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.hubMock }) %>
  </section>

  <section class="section_2 article_1__section" id="mac" aria-labelledby="mac-heading">
    <h2 class="section_2__h1" id="mac-heading"><%= l.macTitle %></h2>
    <ul class="rules_1">
      <% l.mac.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="project" aria-labelledby="project-heading">
    <h2 class="section_2__h1" id="project-heading"><%= l.projectTitle %></h2>
    <p class="article_1__p"><%= l.projectLead %></p>
    <h3 class="section_2__h2"><%= l.projectVccLabel %></h3>
    <ol class="steps_1">
      <% l.projectVcc.forEach(function (step) { %><li><%= step %></li><% }); %>
    </ol>
    <h3 class="section_2__h2"><%= l.projectAlcomLabel %></h3>
    <ol class="steps_1">
      <% l.projectAlcom.forEach(function (step) { %><li><%= step %></li><% }); %>
    </ol>
    <p class="article_1__p"><%= l.projectNote %></p>
  </section>

  <section class="section_2 article_1__section" id="packages" aria-labelledby="packages-heading">
    <h2 class="section_2__h1" id="packages-heading"><%= l.packagesTitle %></h2>
    <% l.packages.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%= c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%= c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
