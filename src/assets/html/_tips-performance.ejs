    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="rank" aria-labelledby="rank-heading">
    <h2 class="section_2__h1" id="rank-heading"><%= l.rankTitle %></h2>
    <p class="article_1__p"><%= l.rankLead %></p>
    <dl class="examples_1 examples_1--grid">
      <% l.rankItems.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%= item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <% l.rankNotes.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="seen" aria-labelledby="seen-heading">
    <h2 class="section_2__h1" id="seen-heading"><%= l.seenTitle %></h2>
    <% l.seen.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <%- include("_mock", { mock: l.seenMock }) %>
    <section class="table_3" tabindex="0" aria-label="<%= l.seenTableLabel %>">
      <table>
        <thead>
          <tr><% l.seenHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.seenRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%= row[1] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.seen2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <p class="section_2__more"><a href="<%= l.seenLink.href %>"><%= l.seenLink.text %></a></p>
  </section>

  <section class="section_2 article_1__section" id="limits" aria-labelledby="limits-heading">
    <h2 class="section_2__h1" id="limits-heading"><%= l.limitsTitle %></h2>
    <p class="article_1__p"><%= l.limitsLead %></p>
    <section class="table_3" tabindex="0" aria-label="<%= l.limitsTableLabel %>">
      <table>
        <thead>
          <tr><% l.limitsHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.pcLimits.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><% row.slice(1).forEach(function (cell) { %><td class="table_3__nowrap"><%= cell %></td><% }); %></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.limitsNotes.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="where" aria-labelledby="where-heading">
    <h2 class="section_2__h1" id="where-heading"><%= l.whereTitle %></h2>
    <p class="article_1__p"><%= l.whereLead %></p>
    <h3 class="section_2__h2"><%= l.whereUnityLabel %></h3>
    <ol class="steps_1">
      <% l.whereUnity.forEach(function (step) { %><li><%= step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.sdkMock }) %>
    <h3 class="section_2__h2"><%= l.whereGameLabel %></h3>
    <ol class="steps_1">
      <% l.whereGame.forEach(function (step) { %><li><%= step %></li><% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="why" aria-labelledby="why-heading">
    <h2 class="section_2__h1" id="why-heading"><%= l.whyTitle %></h2>
    <% l.why.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="demo" aria-labelledby="demo-heading">
    <h2 class="section_2__h1" id="demo-heading"><%= l.demoTitle %></h2>
    <p class="article_1__p"><%= l.demoLead %></p>
    <div class="demo_2 js_rank_demo"
      data-ranks="<%= ranks.join(",") %>" data-ok="<%= l.demo.ok %>" data-ng="<%= l.demo.ng %>"
      data-why="<%= l.demo.why %>" data-all-best="<%= l.demo.allBest %>" data-mark="<%= l.demo.mark %>">
      <div class="demo_2__controls" role="group" aria-label="<%= l.demo.controlsLabel %>">
        <% demoItems.forEach(function (item) { %>
          <div class="demo_1__range">
            <p class="demo_1__label"><label for="<%= item.id %>"><%= item.name %></label> <output class="demo_1__value" for="<%= item.id %>"><%= item.text %></output></p>
            <input type="range" id="<%= item.id %>" class="js_rank_input" min="<%= item.min %>" max="<%= item.max %>" step="<%= item.step %>" value="<%= item.value %>"
              data-name="<%= item.name %>" data-limits="<%= item.limits.join(",") %>"<% if (item.unit) { %> data-unit="<%= item.unit %>"<% } %>>
          </div>
        <% }); %>
      </div>
      <div class="demo_2__output" aria-live="polite">
        <p class="demo_1__result <%= demoWorst <= 2 ? "is_ok" : "is_ng" %> js_rank_result"><%= (demoWorst <= 2 ? l.demo.ok : l.demo.ng).replace("{r}", ranks[demoWorst]) %></p>
        <p class="demo_1__why js_rank_why"><%= demoWorst === 0 ? l.demo.allBest : l.demo.why.replace("{i}", demoWorstNames).replace("{r}", ranks[demoWorst]) %></p>
        <p class="demo_1__label"><%= l.demo.listLabel %></p>
        <ul class="rules_1 js_rank_list">
          <% demoItems.forEach(function (item) { const line = `${item.name}：${item.text} → ${ranks[item.rank]}`; %>
            <li><% if (item.rank === demoWorst && demoWorst > 0) { %><strong><%= line %><%= l.demo.mark %></strong><% } else { %><%= line %><% } %></li>
          <% }); %>
        </ul>
      </div>
      <noscript><p class="section_2__note"><%= l.demo.noJs %></p></noscript>
    </div>
  </section>

  <section class="section_2 article_1__section" id="light" aria-labelledby="light-heading">
    <h2 class="section_2__h1" id="light-heading"><%= l.lightTitle %></h2>
    <p class="article_1__p"><%= l.lightLead %></p>
    <dl class="examples_1 examples_1--grid">
      <% l.light.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%= item.body %></dd>
        </div>
      <% }); %>
    </dl>
  </section>

  <section class="section_2 article_1__section" id="aao" aria-labelledby="aao-heading">
    <h2 class="section_2__h1" id="aao-heading"><%= l.aaoTitle %></h2>
    <p class="article_1__p"><%= l.aaoLead %></p>
    <ol class="steps_1">
      <% l.aao.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <p class="section_2__more"><a href="<%= l.aaoLink.href %>"><%= l.aaoLink.text %></a></p>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%= c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.cause %></dt><dd><%= c.cause %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%= c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
