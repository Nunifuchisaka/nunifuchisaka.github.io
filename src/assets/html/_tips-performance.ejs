    whereUnityLabel: "In Unity (before you upload)",
    whereGameLabel: "In VRChat (after you upload)",
    sdkMock: {
      variant: "unity",
      caption: "Recreated view: the performance section of the VRChat SDK Builder. The layout, look and wording are simplified. The numbers are examples.",
      screens: [{
