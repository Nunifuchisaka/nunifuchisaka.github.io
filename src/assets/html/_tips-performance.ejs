        rows: [
          { mark: 1, label: "Overall Performance", type: "value", text: "Poor", hot: true },
          { type: "head", text: "Stats" },
          { mark: 2, label: "Triangles", type: "value", text: "69,000 · Good" },
          { label: "Material Slots", type: "value", text: "12 · Medium" },
          { label: "Skinned Meshes", type: "value", text: "6 · Medium" },
          { mark: 3, label: "PhysBones Components", type: "value", text: "20 · Poor", hot: true },
          { label: "Bones", type: "value", text: "300 · Poor" },
          { label: "Texture Memory", type: "value", text: "120 MB · Poor" },
        ],
      }],
      notes: [
        "The rank of the whole avatar. It is the rank of the lowest item.",
        "The triangle count is in the Good range. Lowering it won't raise the overall rank.",
        "An item that lowers the rank. Reduce it to raise the rank.",
      ],
    },
    whyTitle: "Why you should make your avatar lighter",
    why: [
      "Your avatar is drawn on other people's PCs too. A heavy avatar <strong>puts load on the PCs of everyone around you</strong> and lowers their frame rate (smoothness). In crowded places, this adds up.",
      "In particular, many materials and meshes mean more draw commands (draw calls). This often matters more than the triangle count.",
      "A lot of texture memory can use up the graphics card's memory (VRAM), which causes stutters or crashes.",
    ],
    demoTitle: "Try it yourself",
    demoLead: "Change the numbers for the main items and see what happens to the avatar's overall rank. The lowest item decides the overall rank.",
    demo: {
      controlsLabel: "Item counts",
      listLabel: "Rank of each item",
      ok: "This avatar's rank is {r}. You rarely run into trouble with it.",
      ng: "This avatar's rank is {r}. Reduce the items in bold to raise the rank.",
      why: "Lowest: {i} ({r}). The rank is decided by the lowest item.",
      allBest: "Every item is in the Excellent range.",
      mark: " (lowest)",
      noJs: "Turn on JavaScript to use this figure.",
      // limits は Excellent・Good・Medium・Poor の上限（パソコン版）
      items: [
        { id: "rank-tris", name: "Triangles", min: 0, max: 150000, step: 1000, value: 69000, limits: [32000, 70000, 70000, 70000] },
        { id: "rank-tex", name: "Texture Memory", unit: " MB", min: 0, max: 300, step: 5, value: 120, limits: [40, 75, 110, 150] },
        { id: "rank-skinned", name: "Skinned Meshes", min: 1, max: 24, step: 1, value: 6, limits: [1, 2, 8, 16] },
        { id: "rank-mats", name: "Material Slots", min: 1, max: 48, step: 1, value: 12, limits: [4, 8, 16, 32] },
        { id: "rank-bones", name: "Bones", min: 0, max: 600, step: 5, value: 300, limits: [75, 150, 256, 400] },
        { id: "rank-pb", name: "PhysBones", min: 0, max: 48, step: 1, value: 20, limits: [4, 8, 16, 32] },
        { id: "rank-pbt", name: "Bones moved by PhysBones", min: 0, max: 400, step: 4, value: 180, limits: [16, 64, 128, 256] },
      ],
    },
    lightTitle: "How to make your avatar lighter",
    lightLead: "These are listed from most to least effective. Before you cut anything from the original avatar, try 1 and 2 first.",
    light: [
      { head: "1. Add Avatar Optimizer (AAO)", body: "A tool that makes your avatar lighter automatically when you upload, without changing how it looks. It removes unused parts, merges meshes, merges PhysBones and more. It doesn't change your original avatar. To install it, see \"Optimize with AAO\" below." },
      { head: "2. Delete outfits you don't use", body: "Things you have turned off are counted too. For outfits and accessories you never switch to, don't just turn them off. Delete them from the avatar (it's safer to duplicate the avatar for uploading and delete them from the copy)." },
      { head: "3. Merge meshes and materials", body: "There are tools that merge meshes, and tools that combine textures into one (make an atlas) to reduce materials. Fewer materials and meshes mean fewer draw calls." },
      { head: "4. Reduce PhysBones", body: "Remove PhysBones from parts that don't need to sway, or combine ones with the same settings into one. You can also reduce the number of bones they move." },
      { head: "5. Make textures smaller", body: "Select a texture and lower \"Max Size\" in the Inspector (going from 2048 to 1024 cuts memory to about a quarter). Keep the size for textures that need fine detail, such as the eyes. \"Use Crunch Compression\" makes the download smaller, but it doesn't reduce texture memory." },
      { head: "6. Reduce polygons", body: "There are tools that reduce polygons, but they easily break the look, so use them as a last resort. If your triangle count is in the Good range, fix the other items first." },
    ],
    aaoTitle: "Optimize with AAO",
    aaoLead: "AAO doesn't change your original avatar. It makes the avatar lighter when you press Play and when you upload. If you no longer need it, just remove the component to go back.",
    aao: [
      `From the link on the ${ext(links.aao, "AAO page")}, add anatawa12's repository to VCC or ALCOM (see ${tipNo("setup")} for how to add one).`,
      "Add \"AAO: Avatar Optimizer\" on your project's management screen.",
      "In the Hierarchy, select the top of your avatar (the object with the VRC Avatar Descriptor).",
      "In the Inspector, use \"Add Component\" to find and add \"AAO Trace And Optimize\". The default settings are fine.",
      "Press Play and check that the look and gimmicks haven't changed, then upload. The Builder's rank may not show the numbers after AAO's optimization, so check \"Avatar Stats\" in VRChat after you upload.",
    ],
    aaoLink: { href: `${prefix}/avatar-tips/setup/#packages`, text: `${tipNo("setup")} Adding tools and shaders` },
    casesTitle: "Common problems",
    caseLabels: { symptom: "What happens", cause: "Cause", fix: "Fix" },
    cases: [
      { title: "Adding outfits made it Very Poor",
        symptom: "You added a few outfits and made them switchable from the menu, and the avatar became Very Poor.",
        cause: "Outfits that are off are counted too, so the number of meshes, materials and PhysBones went up.",
        fix: "Delete outfits you don't switch to. Adding AAO's Trace And Optimize may also merge meshes and reduce the count." },
      { title: "Only the PhysBone items are Poor",
        symptom: "Everything else is Good, but the PhysBones count or the bones they move make it Poor.",
        cause: "Each outfit comes with its own PhysBones for hair and clothes.",
        fix: "Remove PhysBones from parts that don't need to sway, or let AAO merge them." },
      { title: "Texture memory is too high",
        symptom: "Texture Memory goes over 150 MB and the avatar becomes Very Poor.",
        cause: "There are many large textures, such as 4096.",
        fix: "Starting with textures on parts that don't stand out, lower Max Size to 2048 or 1024." },
      { title: "Other people see a different avatar",
        symptom: "You can see your avatar, but others see a stand-in (Fallback) or a robot.",
        cause: "The viewer has set the displayed rank to Medium or similar, or is on mobile or Quest.",
        fix: "Raising your rank lets more people see your avatar. For people on mobile or Quest, prepare a version of your avatar that supports them (" + tipNo("quest") + ")." },
    ],
    careTitle: "Things to watch out for",
    care: [
      "Before you cut anything, export your avatar's folder or back up your project. Some cuts can't be undone.",
      "Before cutting things directly, try tools like AAO that don't change the original.",
      "The rank is a guide. Medium is enough. You don't need to ruin a look you like just to raise the rank.",
      "VRChat may change the rank limits. Check VRChat's official page for the latest numbers.",
    ],
    sumTitle: "Summary",
    sum: [
      "Your avatar's rank is decided by its lowest item.",
      "Outfits you have turned off are counted too. Delete things you don't use.",
      "First add AAO's Trace And Optimize, then review materials, PhysBones and textures.",
      "Aim for Good, and if that is hard, Medium is enough.",
    ],
    back: "All Avatar Tips",
  },
}[pageLocale];
const demoItems = l.demo.items.map((item) => ({ ...item, rank: rankOf(item.value, item.limits), text: fmt(item.value) + (item.unit || "") }));
const demoWorst = Math.max(...demoItems.map((item) => item.rank));
const demoWorstNames = demoItems.filter((item) => item.rank === demoWorst).map((item) => item.name).join(nameJoin);
const sections = [
  { id: "when", title: l.whenTitle },
  { id: "rank", title: l.rankTitle },
  { id: "seen", title: l.seenTitle },
  { id: "limits", title: l.limitsTitle },
  { id: "where", title: l.whereTitle },
  { id: "why", title: l.whyTitle },
  { id: "demo", title: l.demoTitle },
  { id: "light", title: l.lightTitle },
  { id: "aao", title: l.aaoTitle },
  { id: "cases", title: l.casesTitle },
  { id: "care", title: l.careTitle },
  { id: "summary", title: l.sumTitle },
];
%><article class="article_1" aria-labelledby="article-heading">
  <header class="section_2 page_1 article_1__header">
    <p class="article_1__series"><a href="<%= prefix %>/avatar-tips/"><%= l.series %></a></p>
    <h1 class="page_1__h1" id="article-heading"><%= l.title %></h1>
    <p class="article_1__lead"><%= l.lead %></p>
    <p class="section_2__note"><%= l.publishedLabel %> <time datetime="<%= article.published %>"><%= published %></time> · <%= l.meta %></p>
    <nav class="jump_1" aria-label="<%= l.tocLabel %>">
      <ul>
        <% sections.forEach(function (s) { %>
          <li><a href="#<%= s.id %>"><%= s.title %></a></li>
        <% }); %>
      </ul>
    </nav>
  </header>

  <section class="section_2 article_1__section" id="when" aria-labelledby="when-heading">
    <h2 class="section_2__h1" id="when-heading"><%= l.whenTitle %></h2>
    <ul class="rules_1">
      <% l.when.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="rank" aria-labelledby="rank-heading">
    <h2 class="section_2__h1" id="rank-heading"><%= l.rankTitle %></h2>
    <p class="article_1__p"><%= l.rankLead %></p>
    <dl class="examples_1 examples_1--grid">
      <% l.rankItems.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%= item.body %></dd>
        </div>
      <% }); %>
    </dl>
    <% l.rankNotes.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="seen" aria-labelledby="seen-heading">
    <h2 class="section_2__h1" id="seen-heading"><%= l.seenTitle %></h2>
    <% l.seen.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <%- include("_mock", { mock: l.seenMock }) %>
    <section class="table_3" tabindex="0" aria-label="<%= l.seenTableLabel %>">
      <table>
        <thead>
          <tr><% l.seenHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.seenRows.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><td><%= row[1] %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.seen2.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
    <p class="section_2__more"><a href="<%= l.seenLink.href %>"><%= l.seenLink.text %></a></p>
  </section>

  <section class="section_2 article_1__section" id="limits" aria-labelledby="limits-heading">
    <h2 class="section_2__h1" id="limits-heading"><%= l.limitsTitle %></h2>
    <p class="article_1__p"><%= l.limitsLead %></p>
    <section class="table_3" tabindex="0" aria-label="<%= l.limitsTableLabel %>">
      <table>
        <thead>
          <tr><% l.limitsHead.forEach(function (h) { %><th scope="col"><%= h %></th><% }); %></tr>
        </thead>
        <tbody>
          <% l.pcLimits.forEach(function (row) { %>
            <tr><th scope="row"><%= row[0] %></th><% row.slice(1).forEach(function (cell) { %><td class="table_3__nowrap"><%= cell %></td><% }); %></tr>
          <% }); %>
        </tbody>
      </table>
    </section>
    <% l.limitsNotes.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="where" aria-labelledby="where-heading">
    <h2 class="section_2__h1" id="where-heading"><%= l.whereTitle %></h2>
    <p class="article_1__p"><%= l.whereLead %></p>
    <h3 class="section_2__h2"><%= l.whereUnityLabel %></h3>
    <ol class="steps_1">
      <% l.whereUnity.forEach(function (step) { %><li><%= step %></li><% }); %>
    </ol>
    <%- include("_mock", { mock: l.sdkMock }) %>
    <h3 class="section_2__h2"><%= l.whereGameLabel %></h3>
    <ol class="steps_1">
      <% l.whereGame.forEach(function (step) { %><li><%= step %></li><% }); %>
    </ol>
  </section>

  <section class="section_2 article_1__section" id="why" aria-labelledby="why-heading">
    <h2 class="section_2__h1" id="why-heading"><%= l.whyTitle %></h2>
    <% l.why.forEach(function (text) { %><p class="article_1__p"><%- text %></p><% }); %>
  </section>

  <section class="section_2 article_1__section" id="demo" aria-labelledby="demo-heading">
    <h2 class="section_2__h1" id="demo-heading"><%= l.demoTitle %></h2>
    <p class="article_1__p"><%= l.demoLead %></p>
    <div class="demo_2 js_rank_demo"
      data-ranks="<%= ranks.join(",") %>" data-ok="<%= l.demo.ok %>" data-ng="<%= l.demo.ng %>"
      data-why="<%= l.demo.why %>" data-all-best="<%= l.demo.allBest %>" data-mark="<%= l.demo.mark %>"
      data-sep="<%= listSep %>" data-join="<%= nameJoin %>" data-num-locale="<%= numLocale %>">
      <div class="demo_2__controls" role="group" aria-label="<%= l.demo.controlsLabel %>">
        <% demoItems.forEach(function (item) { %>
          <div class="demo_1__range">
            <p class="demo_1__label"><label for="<%= item.id %>"><%= item.name %></label> <output class="demo_1__value" for="<%= item.id %>"><%= item.text %></output></p>
            <input type="range" id="<%= item.id %>" class="js_rank_input" min="<%= item.min %>" max="<%= item.max %>" step="<%= item.step %>" value="<%= item.value %>"
              data-name="<%= item.name %>" data-limits="<%= item.limits.join(",") %>"<% if (item.unit) { %> data-unit="<%= item.unit %>"<% } %>>
          </div>
        <% }); %>
      </div>
      <div class="demo_2__output" aria-live="polite">
        <p class="demo_1__result <%= demoWorst <= 2 ? "is_ok" : "is_ng" %> js_rank_result"><%= (demoWorst <= 2 ? l.demo.ok : l.demo.ng).replace("{r}", ranks[demoWorst]) %></p>
        <p class="demo_1__why js_rank_why"><%= demoWorst === 0 ? l.demo.allBest : l.demo.why.replace("{i}", demoWorstNames).replace("{r}", ranks[demoWorst]) %></p>
        <p class="demo_1__label"><%= l.demo.listLabel %></p>
        <ul class="rules_1 js_rank_list">
          <% demoItems.forEach(function (item) { const line = `${item.name}${listSep}${item.text} → ${ranks[item.rank]}`; %>
            <li><% if (item.rank === demoWorst && demoWorst > 0) { %><strong><%= line %><%= l.demo.mark %></strong><% } else { %><%= line %><% } %></li>
          <% }); %>
        </ul>
      </div>
      <noscript><p class="section_2__note"><%= l.demo.noJs %></p></noscript>
    </div>
  </section>

  <section class="section_2 article_1__section" id="light" aria-labelledby="light-heading">
    <h2 class="section_2__h1" id="light-heading"><%= l.lightTitle %></h2>
    <p class="article_1__p"><%= l.lightLead %></p>
    <dl class="examples_1 examples_1--grid">
      <% l.light.forEach(function (item) { %>
        <div class="examples_1__item">
          <dt><%= item.head %></dt>
          <dd><%= item.body %></dd>
        </div>
      <% }); %>
    </dl>
  </section>

  <section class="section_2 article_1__section" id="aao" aria-labelledby="aao-heading">
    <h2 class="section_2__h1" id="aao-heading"><%= l.aaoTitle %></h2>
    <p class="article_1__p"><%= l.aaoLead %></p>
    <ol class="steps_1">
      <% l.aao.forEach(function (step) { %><li><%- step %></li><% }); %>
    </ol>
    <p class="section_2__more"><a href="<%= l.aaoLink.href %>"><%= l.aaoLink.text %></a></p>
  </section>

  <section class="section_2 article_1__section" id="cases" aria-labelledby="cases-heading">
    <h2 class="section_2__h1" id="cases-heading"><%= l.casesTitle %></h2>
    <div class="case_1">
      <% l.cases.forEach(function (c) { %>
        <section class="case_1__item">
          <h3 class="case_1__title"><%= c.title %></h3>
          <dl class="case_1__list">
            <div><dt><%= l.caseLabels.symptom %></dt><dd><%= c.symptom %></dd></div>
            <div><dt><%= l.caseLabels.cause %></dt><dd><%= c.cause %></dd></div>
            <div><dt><%= l.caseLabels.fix %></dt><dd><%= c.fix %></dd></div>
          </dl>
        </section>
      <% }); %>
    </div>
  </section>

  <section class="section_2 article_1__section" id="care" aria-labelledby="care-heading">
    <h2 class="section_2__h1" id="care-heading"><%= l.careTitle %></h2>
    <ul class="rules_1">
      <% l.care.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
  </section>

  <section class="section_2 article_1__section" id="summary" aria-labelledby="summary-heading">
    <h2 class="section_2__h1" id="summary-heading"><%= l.sumTitle %></h2>
    <ul class="rules_1">
      <% l.sum.forEach(function (item) { %><li><%= item %></li><% }); %>
    </ul>
    <p class="section_2__more"><a href="<%= prefix %>/avatar-tips/"><%= l.back %></a></p>
  </section>
</article>
