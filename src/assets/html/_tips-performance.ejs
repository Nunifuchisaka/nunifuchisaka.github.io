    seenTableLabel: "How an avatar looks when it is below the displayed rank",
    seenHead: ["Item over the limit", "How it looks"],
    seenRows: [
      ["Triangles, texture memory, meshes, material slots, bones", "The avatar is replaced by a stand-in (Fallback)"],
      ["PhysBones or Contacts", "All PhysBones and Contacts are removed (hair and other parts stop swaying)"],
      ["Particles, lights, audio and similar", "All of those parts are removed"],
    ],
    seen2: [
      "On mobile and Quest, only avatars up to \"Medium\" are shown from the start, and you can't choose to show Very Poor. This is covered in " + tipNo("quest") + ".",
      "Busy events and groups may ask you to avoid Very Poor avatars. Even if you use a Very Poor avatar with close friends, it's good to have a light avatar ready for crowded places.",
    ],
    seenLink: { href: `${prefix}/avatar-tips/quest/`, text: `${tipNo("quest")} ${tip("quest").title.en}` },
    limitsTitle: "Main items and limits (PC)",
    limitsLead: "If an item goes over the number in the table, it drops to the next rank. If it goes over the Poor number too, it is Very Poor.",
    limitsTableLabel: "Performance rank limits on PC",
    limitsHead: ["Item", "Excellent", "Good", "Medium", "Poor"],
    pcLimits: [
      ["Triangles", "32,000", "70,000", "70,000", "70,000"],
      ["Texture Memory", "40 MB", "75 MB", "110 MB", "150 MB"],
      ["Skinned Meshes", "1", "2", "8", "16"],
      ["Basic Meshes (meshes without skinning)", "4", "8", "16", "24"],
      ["Material Slots", "4", "8", "16", "32"],
      ["Bones", "75", "150", "256", "400"],
      ["PhysBones Components", "4", "8", "16", "32"],
      ["PhysBones Affected Transforms (bones moved by PhysBones)", "16", "64", "128", "256"],
      ["PhysBones Colliders", "4", "8", "16", "32"],
      ["PhysBones Collision Check Count (how many collider checks are made)", "32", "128", "256", "512"],
      ["Contacts", "8", "16", "24", "32"],
      ["Lights", "0", "0", "0", "1"],
      ["Particle Systems", "0", "4", "8", "16"],
      ["Audio Sources", "1", "4", "8", "8"],
    ],
    limitsNotes: [
      `<strong>Things you have turned off are counted too</strong>. Outfits and accessories you switch from the menu still count toward meshes, materials and PhysBones while they are in the avatar, even when off.`,
      `There are other items too, such as size (Bounds Size), Constraints and the number of Animators. You can see every item on ${ext(links.ranks, "VRChat's Performance Ranks page")}.`,
    ],
    whereTitle: "Where to see the rank",
    whereLead: "You can see the rank in Unity before you upload, and in VRChat after you upload.",
    whereUnity: [
